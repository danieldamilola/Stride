<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StrideBrowser</RootNamespace>
    <AssemblyName>Stride</AssemblyName>
    <ApplicationIcon>icons\stride.ico</ApplicationIcon>
    <Version>1.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
  </ItemGroup>

  <!-- Nested projects; exclude from this project's default globs -->
  <ItemGroup>
    <Compile Remove="SpurBrowser.Tests\**" />
    <Compile Remove="src\**" />
    <EmbeddedResource Remove="SpurBrowser.Tests\**" />
    <EmbeddedResource Remove="src\**" />
    <None Remove="SpurBrowser.Tests\**" />
    <None Remove="src\**" />
  </ItemGroup>

  <!-- Embedded HTML templates and JS scripts -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Pages\*.html" />
    <EmbeddedResource Include="Resources\Scripts\*.js" />
  </ItemGroup>

  <!-- Local Assets for Virtual Host -->
  <ItemGroup>
    <Content Include="Resources\Pages\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Extensions\*.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Pages\TCLens\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- App icons - embedded as Resource for WPF single-file compatibility -->
  <ItemGroup>
    <Resource Include="icons\stride-browser-*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons\stride.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
