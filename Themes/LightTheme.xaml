<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  COLORS - Neutral light, based on Radix Gray                     -->
    <Color x:Key="BaseColor">#F9F9F9</Color>
    <Color x:Key="SidebarColor">#F0F0F0</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#E8E8E8</Color>
    <Color x:Key="BorderColor">#D9D9D9</Color>
    <Color x:Key="SeparatorLineColor">#CECECE</Color>
    <Color x:Key="TextPrimaryColor">#202020</Color>
    <Color x:Key="TextSecondaryColor">#5F5F5F</Color>
    <Color x:Key="TextMutedColor">#5F5F5F</Color>
    <Color x:Key="DangerColor">#B42318</Color>
    <Color x:Key="LoadingBarFadeColor">#00646464</Color>
    <Color x:Key="LoadingBarGlowColor">#646464</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BaseBrush"         Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="ContentBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SeparatorLineBrush" Color="{StaticResource SeparatorLineColor}"/>
    <!-- Suggestion popup palette. Owned by the theme, not the window, because the
         address field repaints itself from the popup surface while suggestions are
         open. Reuses the existing surface and border colors so no new palette is
         introduced. Text on the popup therefore has to be the theme text color. -->
    <SolidColorBrush x:Key="SuggestionPopupBackground" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SuggestionPopupBorder"    Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuggestionHoverBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextPrimary"       Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"         Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>

    <!-- Control states follow the theme when it changes at runtime. -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#8D8D8D"/>
    <SolidColorBrush x:Key="AddressFieldBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AddressFieldBorder" Color="#8D8D8D"/>
    <SolidColorBrush x:Key="PinnedTabBackground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TabCloseHoverBackground" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ToolbarPressedBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8D8D8D"/>
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#646464"/>
    <SolidColorBrush x:Key="SelectedTabBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="NeutralSelectedTabBrush" Color="#E0E0E0"/>
    <!-- Component roles belong to the active theme. -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#202020"/>
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#646464"/>
    <SolidColorBrush x:Key="LinkBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ProgressBrush" Color="#646464"/>
</ResourceDictionary>

