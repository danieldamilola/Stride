<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  COLORS — Stride Identity (Warm Light)                     -->
    <Color x:Key="BaseColor">#F5F5F3</Color>
    <Color x:Key="SidebarColor">#EFEFEE</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#E6E6E5</Color>
    <Color x:Key="BorderColor">#D4D4D2</Color>
    <Color x:Key="AccentColor">#D4A574</Color>
    <Color x:Key="AccentWashColor">#20D4A574</Color>
    <Color x:Key="TextPrimaryColor">#111113</Color>
    <Color x:Key="TextSecondaryColor">#666461</Color>
    <Color x:Key="TextMutedColor">#A5A3A0</Color>
    <Color x:Key="DangerColor">#C4453A</Color>
    <Color x:Key="LoadingBarFadeColor">#00D4A574</Color>
    <Color x:Key="LoadingBarGlowColor">#D4A574</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BaseBrush"         Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="ContentBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Accent"            Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentWash"        Color="{StaticResource AccentWashColor}"/>
    <SolidColorBrush x:Key="TextPrimary"       Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"         Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>
</ResourceDictionary>
