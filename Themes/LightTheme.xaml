<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  COLORS - Stride Identity (Warm Light)                     -->
    <Color x:Key="BaseColor">#F5F5F3</Color>
    <Color x:Key="SidebarColor">#EFEFEE</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#E6E6E5</Color>
    <Color x:Key="BorderColor">#D4D4D2</Color>
    <Color x:Key="AccentColor">#d4d4d4</Color>
    <Color x:Key="AccentWashColor">#20d4d4d4</Color>
    <Color x:Key="TextPrimaryColor">#111113</Color>
    <Color x:Key="TextSecondaryColor">#666461</Color>
    <Color x:Key="TextMutedColor">#A5A3A0</Color>
    <Color x:Key="DangerColor">#C4453A</Color>
    <Color x:Key="LoadingBarFadeColor">#00d4d4d4</Color>
    <Color x:Key="LoadingBarGlowColor">#d4d4d4</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BaseBrush"         Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="ContentBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <!-- Suggestion popup palette. Owned by the theme, not the window, because the
         address field repaints itself from the popup surface while suggestions are
         open. Reuses the existing surface and border colors so no new palette is
         introduced. Text on the popup therefore has to be the theme text color. -->
    <SolidColorBrush x:Key="SuggestionPopupBackground" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SuggestionPopupBorder"    Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuggestionHoverBackground" Color="#0F000000"/>
    <SolidColorBrush x:Key="Accent"            Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentWash"        Color="{StaticResource AccentWashColor}"/>
    <SolidColorBrush x:Key="TextPrimary"       Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"         Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>
</ResourceDictionary>

