<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  COLORS - Neutral charcoal                           -->
    <Color x:Key="BaseColor">#111111</Color>
    <Color x:Key="SidebarColor">#191919</Color>
    <Color x:Key="SurfaceColor">#222222</Color>
    <Color x:Key="SurfaceHoverColor">#2A2A2A</Color>
    <Color x:Key="BorderColor">#313131</Color>
    <Color x:Key="SeparatorLineColor">#3C3C42</Color>
    <Color x:Key="AccentColor">#d4d4d4</Color>
    <Color x:Key="AccentWashColor">#18d4d4d4</Color>
    <Color x:Key="TextPrimaryColor">#EEEEEE</Color>
    <Color x:Key="TextSecondaryColor">#B4B4B4</Color>
    <Color x:Key="TextMutedColor">#8A8A8A</Color>
    <Color x:Key="DangerColor">#C4453A</Color>
    <Color x:Key="LoadingBarFadeColor">#00d4d4d4</Color>
    <Color x:Key="LoadingBarGlowColor">#d4d4d4</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BaseBrush"         Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="ContentBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SeparatorLineBrush" Color="{StaticResource SeparatorLineColor}"/>
    <!-- Address suggestions use the same surface as other dark menus. -->
    <SolidColorBrush x:Key="SuggestionPopupBackground" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SuggestionPopupBorder"    Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuggestionHoverBackground" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="Accent"            Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentWash"        Color="{StaticResource AccentWashColor}"/>
    <SolidColorBrush x:Key="TextPrimary"       Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"         Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>

    <!-- Control states follow the theme when it changes at runtime. -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#606060"/>
    <SolidColorBrush x:Key="AddressFieldBackground" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="AddressFieldBorder" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PinnedTabBackground" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="TabCloseHoverBackground" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="ToolbarPressedBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="SelectedTabBrush" Color="{DynamicResource AccentWashColor}"/>
    <SolidColorBrush x:Key="NeutralSelectedTabBrush" Color="#2A2A2A"/>
</ResourceDictionary>

