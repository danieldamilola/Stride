<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  COLORS - Stride Identity (Dark)                           -->
    <Color x:Key="BaseColor">#111113</Color>
    <Color x:Key="SidebarColor">#151517</Color>
    <Color x:Key="SurfaceColor">#1A1A1E</Color>
    <Color x:Key="SurfaceHoverColor">#252528</Color>
    <Color x:Key="BorderColor">#2A2A2E</Color>
    <Color x:Key="AccentColor">#d4d4d4</Color>
    <Color x:Key="AccentWashColor">#18d4d4d4</Color>
    <Color x:Key="TextPrimaryColor">#E8E4DF</Color>
    <Color x:Key="TextSecondaryColor">#8A8680</Color>
    <Color x:Key="TextMutedColor">#4A4844</Color>
    <Color x:Key="DangerColor">#C4453A</Color>
    <Color x:Key="LoadingBarFadeColor">#00d4d4d4</Color>
    <Color x:Key="LoadingBarGlowColor">#d4d4d4</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BaseBrush"         Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="ContentBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <!-- Suggestion popup palette. Owned by the theme, not the window, because the
         address field repaints itself from the popup surface while suggestions are
         open. One hard coded dark surface left the light theme with a dark field
         and dark popup. Values are the previous window defaults unchanged. -->
    <SolidColorBrush x:Key="SuggestionPopupBackground" Color="#111111"/>
    <SolidColorBrush x:Key="SuggestionPopupBorder"    Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuggestionHoverBackground" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Accent"            Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentWash"        Color="{StaticResource AccentWashColor}"/>
    <SolidColorBrush x:Key="TextPrimary"       Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"         Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>
</ResourceDictionary>

