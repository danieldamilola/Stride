  "nodes": {
    "var_a3f693a469c3": {
      "type": "variant",
      "label": "T&C Lens — Landing Page",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .tc-root { font-family: 'Inter', system-ui, -apple-system, sans-serif; }\n  .tc-mono { font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace; }\n\n  .tc-btn { background:#efefef; color:#0e0e0e; padding:11px 24px; font-size:11px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; transition:opacity 0.1s linear; cursor:pointer; }\n  .tc-btn:hover { opacity:0.82; }\n  .tc-btn-ghost { color:#5a5a5a; text-transform:uppercase; letter-spacing:0.06em; font-size:11px; font-weight:500; padding:11px 12px; transition:color 0.1s linear; cursor:pointer; background:transparent; border:none; }\n  .tc-btn-ghost:hover { color:#efefef; }\n  .tc-navlink { color:#5a5a5a; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; transition:color 0.1s linear; text-decoration:none; }\n  .tc-navlink:hover { color:#efefef; }\n  .tc-label { font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:#5a5a5a; }\n  .tc-copybtn { background:transparent; border:1px solid #2a2a2a; color:#5a5a5a; font-size:10px; padding:4px 8px; border-radius:4px; text-transform:uppercase; letter-spacing:0.05em; transition:all 0.1s linear; cursor:pointer; font-family:'JetBrains Mono', monospace; }\n  .tc-copybtn:hover { border-color:#5a5a5a; color:#efefef; }\n  details.tc-faq summary::-webkit-details-marker { display:none; }\n  details.tc-faq summary { list-style:none; cursor:pointer; }\n  details.tc-faq .faq-plus { transition:transform 0.1s linear; }\n  details[open].tc-faq .faq-plus { transform:rotate(45deg); }\n  .fade-el { opacity:0; }\n</style>\n<div class=\"tc-root bg-[#0e0e0e] text-[#efefef] min-h-screen antialiased\" data-kid=\"1\">\n    <!-- 1 · HEADER -->\n    <header class=\"sticky top-0 z-50 h-12 border-b border-[#1f1f1f] bg-[#0e0e0e]\" data-kid=\"1-1\">\n        <div class=\"max-w-[1100px] mx-auto h-full px-10 flex items-center justify-between\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\">\n                <img alt=\"T&C Lens logo\" class=\"w-[18px] h-[18px]\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/icons/icon48.png\"/>\n                <span class=\"text-[12px] font-semibold uppercase\" data-kid=\"1-1-1-1-2\" style=\"letter-spacing:0.14em;\">\n                    T&C Lens\n                </span>\n            </div>\n            <nav class=\"flex items-center gap-8\" data-kid=\"1-1-1-2\">\n                <a class=\"tc-navlink\" data-kid=\"1-1-1-2-1\" href=\"#features\">\n                    Features\n                </a>\n                <a class=\"tc-navlink\" data-kid=\"1-1-1-2-2\" href=\"#providers\">\n                    Providers\n                </a>\n                <a class=\"tc-navlink\" data-kid=\"1-1-1-2-3\" href=\"#faq\">\n                    FAQ\n                </a>\n                <a aria-label=\"GitHub\" class=\"tc-navlink text-[16px] flex items-center\" data-kid=\"1-1-1-2-4\" href=\"#\">\n                    <i class=\"ti ti-brand-github\" data-kid=\"1-1-1-2-4-1\">\n                    </i>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <!-- 2 · HERO -->\n    <section class=\"max-w-[960px] mx-auto px-10 pt-28 pb-20\" data-kid=\"1-2\">\n        <p class=\"tc-label fade-el\" data-fade=\"\" data-kid=\"1-2-1\">\n            Browser Extension — Chrome MV3 · Firefox\n        </p>\n        <h1 class=\"fade-el mt-7 text-[64px] leading-[1.05] font-medium tracking-[-0.02em] max-w-[760px]\" data-fade=\"\" data-kid=\"1-2-2\">\n            Understand what you're agreeing to.\n        </h1>\n        <p class=\"fade-el mt-7 text-[15px] leading-[1.7] text-[#5a5a5a] max-w-[560px]\" data-fade=\"\" data-kid=\"1-2-3\">\n            T&C Lens reads the fine print so you don't have to. Point it at any Terms of Service — get a plain-English summary, a 0–100 risk score, and a finding-by-finding breakdown.\n        </p>\n        <div class=\"fade-el mt-10 flex items-center gap-4\" data-fade=\"\" data-kid=\"1-2-4\">\n            <button class=\"tc-btn\" data-kid=\"1-2-4-1\">\n                Add to Chrome\n            </button>\n            <button class=\"tc-btn-ghost flex items-center gap-2\" data-kid=\"1-2-4-2\">\n                <i class=\"ti ti-code text-[14px]\" data-kid=\"1-2-4-2-1\">\n                </i>\n                View Source\n            </button>\n        </div>\n        <p class=\"fade-el tc-mono mt-10 text-[11px] text-[#5a5a5a] tracking-[0.06em]\" data-fade=\"\" data-kid=\"1-2-5\">\n            MIT LICENSE  ·  ZERO DEPENDENCIES  ·  NO TELEMETRY\n        </p>\n    </section>\n    <!-- 3 · PRODUCT MOCKUP -->\n    <section class=\"max-w-[960px] mx-auto px-10 pb-24\" data-kid=\"1-3\">\n        <div class=\"bg-[#161616] border border-[#1f1f1f]\" data-kid=\"1-3-1\" id=\"mockup\">\n            <!-- mock header -->\n            <div class=\"flex items-center justify-between px-8 h-11 border-b border-[#1f1f1f]\" data-kid=\"1-3-1-1\">\n                <span class=\"tc-label\" data-kid=\"1-3-1-1-1\">\n                    Analysis — google.com/policies/terms\n                </span>\n                <span class=\"tc-mono text-[10px] text-[#5a5a5a]\" data-kid=\"1-3-1-1-2\">\n                    2026-07-18 · GEMINI 2.5 FLASH\n                </span>\n            </div>\n            <div class=\"px-8 py-8\" data-kid=\"1-3-1-2\">\n                <div class=\"flex items-end justify-between gap-10 flex-wrap\" data-kid=\"1-3-1-2-1\">\n                    <div data-kid=\"1-3-1-2-1-1\">\n                        <p class=\"tc-label\" data-kid=\"1-3-1-2-1-1-1\">\n                            Risk Score\n                        </p>\n                        <div class=\"flex items-baseline gap-4 mt-2\" data-kid=\"1-3-1-2-1-1-2\">\n                            <span class=\"text-[52px] font-semibold leading-none\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-1-2-1\" data-name=\"risk score number display\" data-reason=\"text content updated by script\" id=\"score-num\" style=\"font-variant-numeric:tabular-nums;\">\n                                0\n                            </span>\n                            <span class=\"tc-label !text-[#efefef]\" data-kid=\"1-3-1-2-1-1-2-2\">\n                                High Risk\n                            </span>\n                        </div>\n                        <div class=\"mt-4 w-[280px] h-[2px] bg-[#1f1f1f]\" data-kid=\"1-3-1-2-1-1-3\">\n                            <div class=\"h-full bg-[#efefef]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-1-3-1\" data-name=\"risk score visual progress bar\" data-reason=\"width attribute updated by script\" id=\"score-bar\" style=\"width:0%;\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"max-w-[380px]\" data-kid=\"1-3-1-2-1-2\" style=\"background:rgba(245,158,11,0.1); border-left:2px solid #f59e0b;\">\n                        <p class=\"tc-mono text-[11px] leading-[1.6] px-4 py-3\" data-kid=\"1-3-1-2-1-2-1\" style=\"color:#f59e0b;\">\n                            HIGH RISK — Significant data collection and liability waiver clauses detected.\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mt-9 text-[13px] leading-[1.7] text-[#5a5a5a] max-w-[640px]\" data-kid=\"1-3-1-2-2\">\n                    This agreement grants broad rights over user data and content, permits unilateral modification of terms, and limits the company's liability to the greatest extent permitted by law.\n                </p>\n                <!-- finding 1 -->\n                <div class=\"mt-8 pt-6 border-t border-[#1f1f1f]\" data-kid=\"1-3-1-2-3\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-3-1-2-3-1\">\n                        <h3 class=\"text-[15px] font-medium\" data-kid=\"1-3-1-2-3-1-1\">\n                            Broad Data Harvesting\n                        </h3>\n                        <span class=\"tc-label !text-[#5a5a5a]\" data-kid=\"1-3-1-2-3-1-2\">\n                            Medium\n                        </span>\n                    </div>\n                    <p class=\"mt-2 text-[13px] leading-[1.7] text-[#5a5a5a] max-w-[640px]\" data-kid=\"1-3-1-2-3-2\">\n                        Collects search history, location information, and activity on third-party sites and apps — beyond what the core service requires.\n                    </p>\n                    <p class=\"tc-mono mt-4 text-[11px] leading-[1.7] text-[#5a5a5a] pl-4 max-w-[620px]\" data-kid=\"1-3-1-2-3-3\" style=\"border-left:2px solid #2a2a2a;\">\n                        \"We use the information that we collect from all our services for the following purposes: provide our services, maintain & improve our services…\"\n                    </p>\n                </div>\n                <!-- finding 2 -->\n                <div class=\"mt-6 pt-6 border-t border-[#1f1f1f]\" data-kid=\"1-3-1-2-4\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-3-1-2-4-1\">\n                        <h3 class=\"text-[15px] font-medium\" data-kid=\"1-3-1-2-4-1-1\">\n                            Unilateral Terms Changes\n                        </h3>\n                        <span class=\"tc-label !text-[#efefef]\" data-kid=\"1-3-1-2-4-1-2\">\n                            High\n                        </span>\n                    </div>\n                    <p class=\"mt-2 text-[13px] leading-[1.7] text-[#5a5a5a] max-w-[640px]\" data-kid=\"1-3-1-2-4-2\">\n                        Terms may be modified at any time; continued use constitutes acceptance. No obligation to notify users individually.\n                    </p>\n                    <p class=\"tc-mono mt-4 text-[11px] leading-[1.7] text-[#5a5a5a] pl-4 max-w-[620px]\" data-kid=\"1-3-1-2-4-3\" style=\"border-left:2px solid #2a2a2a;\">\n                        \"We may modify these terms or any additional terms that apply to a Service to, for example, reflect changes to the law or changes to our Services…\"\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- divider -->\n    <div class=\"border-t border-[#1f1f1f]\" data-kid=\"1-4\">\n    </div>\n    <!-- 4 · HOW IT WORKS -->\n    <section class=\"max-w-[960px] mx-auto px-10 py-24\" data-kid=\"1-5\">\n        <p class=\"tc-mono text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-5-1\">\n            01 — How it works\n        </p>\n        <h2 class=\"mt-4 text-[32px] font-medium tracking-[-0.01em]\" data-kid=\"1-5-2\">\n            Four steps. One click.\n        </h2>\n        <div class=\"mt-12 grid grid-cols-2 gap-[1px] bg-[#1f1f1f] border border-[#1f1f1f]\" data-kid=\"1-5-3\">\n            <div class=\"bg-[#0e0e0e] p-8\" data-kid=\"1-5-3-1\">\n                <i class=\"ti ti-click text-[20px] text-[#efefef]\" data-kid=\"1-5-3-1-1\">\n                </i>\n                <p class=\"tc-mono mt-5 text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-5-3-1-2\">\n                    01. Activate\n                </p>\n                <p class=\"mt-3 text-[13px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-5-3-1-3\">\n                    Click the extension on any legal page — or right-click → Analyze with T&C Lens.\n                </p>\n            </div>\n            <div class=\"bg-[#0e0e0e] p-8\" data-kid=\"1-5-3-2\">\n                <i class=\"ti ti-scan text-[20px] text-[#efefef]\" data-kid=\"1-5-3-2-1\">\n                </i>\n                <p class=\"tc-mono mt-5 text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-5-3-2-2\">\n                    02. Scrape\n                </p>\n                <p class=\"mt-3 text-[13px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-5-3-2-3\">\n                    Smart extraction targets legal text, skipping nav, footers and cookie banners.\n                </p>\n            </div>\n            <div class=\"bg-[#0e0e0e] p-8\" data-kid=\"1-5-3-3\">\n                <i class=\"ti ti-cpu text-[20px] text-[#efefef]\" data-kid=\"1-5-3-3-1\">\n                </i>\n                <p class=\"tc-mono mt-5 text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-5-3-3-2\">\n                    03. Analyze\n                </p>\n                <p class=\"mt-3 text-[13px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-5-3-3-3\">\n                    Text is sent to your chosen AI provider. Nothing touches our servers.\n                </p>\n            </div>\n            <div class=\"bg-[#0e0e0e] p-8\" data-kid=\"1-5-3-4\">\n                <i class=\"ti ti-chart-bar text-[20px] text-[#efefef]\" data-kid=\"1-5-3-4-1\">\n                </i>\n                <p class=\"tc-mono mt-5 text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-5-3-4-2\">\n                    04. Review\n                </p>\n                <p class=\"mt-3 text-[13px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-5-3-4-3\">\n                    Get a 0–100 risk score, a plain-English summary, and quoted findings.\n                </p>\n            </div>\n        </div>\n    </section>\n    <div class=\"border-t border-[#1f1f1f]\" data-kid=\"1-6\">\n    </div>\n    <!-- 5 · PROVIDERS -->\n    <section class=\"max-w-[960px] mx-auto px-10 py-24\" data-kid=\"1-7\" id=\"providers\">\n        <p class=\"tc-mono text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-7-1\">\n            02 — Providers\n        </p>\n        <h2 class=\"mt-4 text-[32px] font-medium tracking-[-0.01em]\" data-kid=\"1-7-2\">\n            Bring your own key.\n        </h2>\n        <p class=\"mt-4 text-[15px] leading-[1.7] text-[#5a5a5a] max-w-[520px]\" data-kid=\"1-7-3\">\n            Works with 9 providers. Use free tiers or your existing API keys. Your key stays in local storage.\n        </p>\n        <div class=\"mt-12 grid grid-cols-3 gap-[1px] bg-[#1f1f1f] border border-[#1f1f1f]\" data-kid=\"1-7-4\">\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-1\">\n                <span class=\"tc-mono text-[13px]\" data-kid=\"1-7-4-1-1\">\n                    Gemini\n                </span>\n                <span class=\"tc-label !text-[#efefef]\" data-kid=\"1-7-4-1-2\">\n                    Free Tier\n                </span>\n            </div>\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-2\">\n                <span class=\"tc-mono text-[13px]\" data-kid=\"1-7-4-2-1\">\n                    Groq\n                </span>\n                <span class=\"tc-label !text-[#efefef]\" data-kid=\"1-7-4-2-2\">\n                    Free Tier\n                </span>\n            </div>\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-3\">\n                <span class=\"tc-mono text-[13px]\" data-kid=\"1-7-4-3-1\">\n                    DeepSeek\n                </span>\n                <span class=\"tc-label !text-[#efefef]\" data-kid=\"1-7-4-3-2\">\n                    Free Tier\n                </span>\n            </div>\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-4\">\n                <span class=\"tc-mono text-[13px]\" data-kid=\"1-7-4-4-1\">\n                    OpenRouter\n                </span>\n                <span class=\"tc-label !text-[#efefef]\" data-kid=\"1-7-4-4-2\">\n                    Free Tier\n                </span>\n            </div>\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-5\">\n                <span class=\"tc-mono text-[13px]\" data-kid=\"1-7-4-5-1\">\n                    Together AI\n                </span>\n                <span class=\"tc-label !text-[#efefef]\" data-kid=\"1-7-4-5-2\">\n                    Free Tier\n                </span>\n            </div>\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-6\">\n                <span class=\"tc-mono text-[13px] text-[#5a5a5a]\" data-kid=\"1-7-4-6-1\">\n                    Mistral\n                </span>\n                <span class=\"tc-mono text-[11px] text-[#2a2a2a]\" data-kid=\"1-7-4-6-2\">\n                    —\n                </span>\n            </div>\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-7\">\n                <span class=\"tc-mono text-[13px] text-[#5a5a5a]\" data-kid=\"1-7-4-7-1\">\n                    OpenAI\n                </span>\n                <span class=\"tc-mono text-[11px] text-[#2a2a2a]\" data-kid=\"1-7-4-7-2\">\n                    —\n                </span>\n            </div>\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-8\">\n                <span class=\"tc-mono text-[13px] text-[#5a5a5a]\" data-kid=\"1-7-4-8-1\">\n                    Anthropic\n                </span>\n                <span class=\"tc-mono text-[11px] text-[#2a2a2a]\" data-kid=\"1-7-4-8-2\">\n                    —\n                </span>\n            </div>\n            <div class=\"bg-[#0e0e0e] px-6 py-5 flex items-center justify-between\" data-kid=\"1-7-4-9\">\n                <span class=\"tc-mono text-[13px] text-[#5a5a5a]\" data-kid=\"1-7-4-9-1\">\n                    xAI\n                </span>\n                <span class=\"tc-mono text-[11px] text-[#2a2a2a]\" data-kid=\"1-7-4-9-2\">\n                    —\n                </span>\n            </div>\n        </div>\n        <p class=\"tc-mono mt-5 text-[10px] text-[#5a5a5a] tracking-[0.08em] uppercase\" data-kid=\"1-7-5\">\n            T&C Lens AI — hosted, no-key option — coming soon\n        </p>\n    </section>\n    <div class=\"border-t border-[#1f1f1f]\" data-kid=\"1-8\">\n    </div>\n    <!-- 6 · PRIVACY -->\n    <section class=\"max-w-[960px] mx-auto px-10 py-24\" data-kid=\"1-9\">\n        <p class=\"tc-mono text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-9-1\">\n            03 — Privacy\n        </p>\n        <div class=\"mt-4 flex gap-14 items-start flex-wrap\" data-kid=\"1-9-2\">\n            <div class=\"max-w-[480px]\" data-kid=\"1-9-2-1\">\n                <h2 class=\"text-[32px] font-medium tracking-[-0.01em] leading-[1.2]\" data-kid=\"1-9-2-1-1\">\n                    Zero telemetry.\n                    <br data-kid=\"1-9-2-1-1-1\"/>\n                    Complete privacy.\n                </h2>\n                <p class=\"mt-5 text-[15px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-9-2-1-2\">\n                    No analytics, no tracking, no data collection. Your API key never leaves local storage. The only external request is the one you trigger to your chosen AI.\n                </p>\n                <div class=\"mt-8 inline-flex items-center justify-center w-14 h-14\" data-kid=\"1-9-2-1-3\" style=\"border:1px solid #f59e0b;\">\n                    <i class=\"ti ti-shield-off text-[22px]\" data-kid=\"1-9-2-1-3-1\" style=\"color:#f59e0b;\">\n                    </i>\n                </div>\n            </div>\n            <div class=\"flex-1 min-w-[340px] grid grid-cols-2 gap-[1px] bg-[#1f1f1f] border border-[#1f1f1f]\" data-kid=\"1-9-2-2\">\n                <div class=\"bg-[#0e0e0e] p-6\" data-kid=\"1-9-2-2-1\">\n                    <p class=\"tc-label\" data-kid=\"1-9-2-2-1-1\">\n                        What stays on your device\n                    </p>\n                    <ul class=\"tc-mono mt-5 text-[11px] leading-[2.2] text-[#efefef]\" data-kid=\"1-9-2-2-1-2\">\n                        <li data-kid=\"1-9-2-2-1-2-1\">\n                            + Your API key\n                        </li>\n                        <li data-kid=\"1-9-2-2-1-2-2\">\n                            + Analysis history\n                        </li>\n                        <li data-kid=\"1-9-2-2-1-2-3\">\n                            + Your settings\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"bg-[#0e0e0e] p-6\" data-kid=\"1-9-2-2-2\">\n                    <p class=\"tc-label\" data-kid=\"1-9-2-2-2-1\">\n                        What gets sent\n                    </p>\n                    <ul class=\"tc-mono mt-5 text-[11px] leading-[2.2] text-[#5a5a5a]\" data-kid=\"1-9-2-2-2-2\">\n                        <li data-kid=\"1-9-2-2-2-2-1\">\n                            → Legal text, to your AI only\n                        </li>\n                        <li data-kid=\"1-9-2-2-2-2-2\">\n                            — No analytics\n                        </li>\n                        <li data-kid=\"1-9-2-2-2-2-3\">\n                            — No telemetry\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n    <div class=\"border-t border-[#1f1f1f]\" data-kid=\"1-10\">\n    </div>\n    <!-- 7 · FEATURES -->\n    <section class=\"max-w-[960px] mx-auto px-10 py-24\" data-kid=\"1-11\" id=\"features\">\n        <p class=\"tc-mono text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-11-1\">\n            04 — Features\n        </p>\n        <h2 class=\"mt-4 text-[32px] font-medium tracking-[-0.01em]\" data-kid=\"1-11-2\">\n            No clutter. Just information.\n        </h2>\n        <div class=\"mt-10\" data-kid=\"1-11-3\">\n            <div class=\"py-6 border-b border-[#1f1f1f] flex items-start justify-between gap-10\" data-kid=\"1-11-3-1\">\n                <div class=\"max-w-[620px]\" data-kid=\"1-11-3-1-1\">\n                    <h3 class=\"text-[15px] font-medium\" data-kid=\"1-11-3-1-1-1\">\n                        Smart Extraction\n                    </h3>\n                    <p class=\"mt-2 text-[13px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-11-3-1-1-2\">\n                        Intelligent scraper targets legal content specifically, filtering out navigation, headers, footers, and cookie banners.\n                    </p>\n                </div>\n                <span class=\"tc-label !text-[#efefef] pt-1\" data-kid=\"1-11-3-1-2\">\n                    Core\n                </span>\n            </div>\n            <div class=\"py-6 border-b border-[#1f1f1f] flex items-start justify-between gap-10\" data-kid=\"1-11-3-2\">\n                <div class=\"max-w-[620px]\" data-kid=\"1-11-3-2-1\">\n                    <h3 class=\"text-[15px] font-medium\" data-kid=\"1-11-3-2-1-1\">\n                        On-Demand Only\n                    </h3>\n                    <p class=\"mt-2 text-[13px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-11-3-2-1-2\">\n                        Fully passive. Does nothing in the background. Runs only when you click.\n                    </p>\n                </div>\n                <span class=\"tc-label pt-1\" data-kid=\"1-11-3-2-2\">\n                    Passive\n                </span>\n            </div>\n            <div class=\"py-6 border-b border-[#1f1f1f] flex items-start justify-between gap-10\" data-kid=\"1-11-3-3\">\n                <div class=\"max-w-[620px]\" data-kid=\"1-11-3-3-1\">\n                    <h3 class=\"text-[15px] font-medium\" data-kid=\"1-11-3-3-1-1\">\n                        History & Export\n                    </h3>\n                    <p class=\"mt-2 text-[13px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-11-3-3-1-2\">\n                        Past analyses saved locally. Export any result as a .txt file.\n                    </p>\n                </div>\n                <span class=\"tc-label !text-[#2a2a2a] pt-1\" data-kid=\"1-11-3-3-2\">\n                    Local\n                </span>\n            </div>\n            <div class=\"py-6 border-b border-[#1f1f1f] flex items-start justify-between gap-10\" data-kid=\"1-11-3-4\">\n                <div class=\"max-w-[620px]\" data-kid=\"1-11-3-4-1\">\n                    <h3 class=\"text-[15px] font-medium\" data-kid=\"1-11-3-4-1-1\">\n                        Minimal Dark UI\n                    </h3>\n                    <p class=\"mt-2 text-[13px] leading-[1.7] text-[#5a5a5a]\" data-kid=\"1-11-3-4-1-2\">\n                        Designed to feel like a premium developer tool. No clutter. No colors. Just information.\n                    </p>\n                </div>\n                <span class=\"tc-label pt-1\" data-kid=\"1-11-3-4-2\">\n                    Design\n                </span>\n            </div>\n        </div>\n    </section>\n    <div class=\"border-t border-[#1f1f1f]\" data-kid=\"1-12\">\n    </div>\n    <!-- 8 · FAQ -->\n    <section class=\"max-w-[960px] mx-auto px-10 py-24\" data-kid=\"1-13\" id=\"faq\">\n        <p class=\"tc-mono text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-13-1\">\n            05 — FAQ\n        </p>\n        <h2 class=\"mt-4 text-[32px] font-medium tracking-[-0.01em]\" data-kid=\"1-13-2\">\n            Questions.\n        </h2>\n        <div class=\"mt-10\" data-kid=\"1-13-3\">\n            <details class=\"tc-faq border-b border-[#1f1f1f]\" data-kid=\"1-13-3-1\">\n                <summary class=\"py-6 flex items-center justify-between\" data-kid=\"1-13-3-1-1\">\n                    <span class=\"text-[15px] font-medium\" data-kid=\"1-13-3-1-1-1\">\n                        Do I need to pay to use T&C Lens?\n                    </span>\n                    <span class=\"faq-plus text-[#5a5a5a] text-[16px] leading-none\" data-kid=\"1-13-3-1-1-2\">\n                        +\n                    </span>\n                </summary>\n                <p class=\"pb-6 text-[13px] leading-[1.7] text-[#5a5a5a] max-w-[640px]\" data-kid=\"1-13-3-1-2\">\n                    No. If you bring your own API key from a free-tier provider — like Google Gemini or Groq — it costs you nothing. Many providers allow hundreds of requests per day for free.\n                </p>\n            </details>\n            <details class=\"tc-faq border-b border-[#1f1f1f]\" data-kid=\"1-13-3-2\">\n                <summary class=\"py-6 flex items-center justify-between\" data-kid=\"1-13-3-2-1\">\n                    <span class=\"text-[15px] font-medium\" data-kid=\"1-13-3-2-1-1\">\n                        Is my data safe?\n                    </span>\n                    <span class=\"faq-plus text-[#5a5a5a] text-[16px] leading-none\" data-kid=\"1-13-3-2-1-2\">\n                        +\n                    </span>\n                </summary>\n                <p class=\"pb-6 text-[13px] leading-[1.7] text-[#5a5a5a] max-w-[640px]\" data-kid=\"1-13-3-2-2\">\n                    Yes. Your data never touches our servers. It goes directly from your browser to the AI provider you selected. We can't see it even if we wanted to.\n                </p>\n            </details>\n            <details class=\"tc-faq border-b border-[#1f1f1f]\" data-kid=\"1-13-3-3\">\n                <summary class=\"py-6 flex items-center justify-between\" data-kid=\"1-13-3-3-1\">\n                    <span class=\"text-[15px] font-medium\" data-kid=\"1-13-3-3-1-1\">\n                        Does it run in the background?\n                    </span>\n                    <span class=\"faq-plus text-[#5a5a5a] text-[16px] leading-none\" data-kid=\"1-13-3-3-1-2\">\n                        +\n                    </span>\n                </summary>\n                <p class=\"pb-6 text-[13px] leading-[1.7] text-[#5a5a5a] max-w-[640px]\" data-kid=\"1-13-3-3-2\">\n                    No. T&C Lens does absolutely nothing until you click the icon. It doesn't monitor your browsing, track your tabs, or use any resources when idle.\n                </p>\n            </details>\n            <details class=\"tc-faq border-b border-[#1f1f1f]\" data-kid=\"1-13-3-4\">\n                <summary class=\"py-6 flex items-center justify-between\" data-kid=\"1-13-3-4-1\">\n                    <span class=\"text-[15px] font-medium\" data-kid=\"1-13-3-4-1-1\">\n                        Does it work on Firefox?\n                    </span>\n                    <span class=\"faq-plus text-[#5a5a5a] text-[16px] leading-none\" data-kid=\"1-13-3-4-1-2\">\n                        +\n                    </span>\n                </summary>\n                <p class=\"pb-6 text-[13px] leading-[1.7] text-[#5a5a5a] max-w-[640px]\" data-kid=\"1-13-3-4-2\">\n                    Yes. Load it as a temporary add-on via about:debugging. Firefox uses background scripts instead of a service worker, so some behavior may differ slightly.\n                </p>\n            </details>\n        </div>\n    </section>\n    <div class=\"border-t border-[#1f1f1f]\" data-kid=\"1-14\">\n    </div>\n    <!-- 9 · OPEN SOURCE CTA -->\n    <section class=\"max-w-[960px] mx-auto px-10 py-24\" data-kid=\"1-15\">\n        <p class=\"tc-mono text-[10px] text-[#5a5a5a] tracking-[0.1em] uppercase\" data-kid=\"1-15-1\">\n            06 — Open Source\n        </p>\n        <h2 class=\"mt-4 text-[32px] font-medium tracking-[-0.01em]\" data-kid=\"1-15-2\">\n            Read the code yourself.\n        </h2>\n        <div class=\"mt-10 bg-[#161616] border border-[#1f1f1f] px-6 py-5 flex items-center justify-between gap-6\" data-kid=\"1-15-3\">\n            <code class=\"tc-mono text-[13px] text-[#efefef] whitespace-nowrap overflow-x-auto\" data-kid=\"1-15-3-1\">\n                <span class=\"text-[#5a5a5a]\" data-kid=\"1-15-3-1-1\">\n                    $\n                </span>\n                git clone https://github.com/danieldamilola/T-C.git\n            </code>\n            <button class=\"tc-copybtn shrink-0\" data-kid=\"1-15-3-2\" data-name=\"copy terminal command button\" id=\"copy-btn\">\n                Copy\n            </button>\n        </div>\n        <p class=\"mt-6 text-[13px] leading-[1.7] text-[#5a5a5a] max-w-[520px]\" data-kid=\"1-15-4\">\n            100% open-source under MIT. Inspect the code, verify the privacy claims, or contribute.\n        </p>\n        <button class=\"tc-btn mt-8 inline-flex items-center gap-2\" data-kid=\"1-15-5\">\n            <i class=\"ti ti-brand-github text-[14px]\" data-kid=\"1-15-5-1\">\n            </i>\n            Star on GitHub\n        </button>\n    </section>\n    <!-- 10 · FOOTER -->\n    <footer class=\"border-t border-[#1f1f1f]\" data-kid=\"1-16\">\n        <div class=\"max-w-[1100px] mx-auto px-10 h-16 flex items-center justify-between\" data-kid=\"1-16-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-16-1-1\">\n                <img alt=\"T&C Lens logo\" class=\"w-[14px] h-[14px] opacity-70\" data-kid=\"1-16-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/icons/icon48.png\"/>\n                <span class=\"tc-mono text-[11px] text-[#5a5a5a] tracking-[0.06em]\" data-kid=\"1-16-1-1-2\">\n                    T&C LENS — MIT LICENSE\n                </span>\n            </div>\n            <div class=\"flex items-center gap-7\" data-kid=\"1-16-1-2\">\n                <a class=\"tc-navlink\" data-kid=\"1-16-1-2-1\" href=\"#\">\n                    GitHub\n                </a>\n                <a class=\"tc-navlink\" data-kid=\"1-16-1-2-2\" href=\"#\">\n                    Report a bug\n                </a>\n                <a class=\"tc-navlink\" data-kid=\"1-16-1-2-3\" href=\"#\">\n                    Request a feature\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  // Hero fade-ins (opacity only, functional)\n  gsap.to('[data-fade]', { opacity: 1, duration: 0.5, ease: 'none', stagger: 0.08 });\n\n  // Score count-up + bar fill when mockup enters view\n  ScrollTrigger.create({\n    trigger: '#mockup',\n    start: 'top 75%',\n    once: true,\n    onEnter: () => {\n</script>\n",
