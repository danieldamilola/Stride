  "nodes": {
    "var_3aec8e9fd2bd": {
      "type": "variant",
      "label": "T&C Lens AI - Auth Forms",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600&display=swap');\n  :root {\n    --bg: #0d0f10;\n    --surface: #131617;\n    --surface-2: #171b1d;\n    --ink: #eff2f1;\n    --muted: #7b858a;\n    --dim: #586267;\n    --rule: #262c2f;\n    --rule-strong: #343c40;\n    --teal: #2b6c63;\n    --teal-soft: #8cc5ba;\n    --amber: #d99b36;\n    --amber-soft: #2b2114;\n  }\n  .auth-page { font-family: 'Outfit', sans-serif; background: var(--bg); color: var(--ink); }\n  .mono { font-family: 'JetBrains Mono', monospace; }\n  .hairline { border-color: var(--rule); }\n  .rule-strong { border-color: var(--rule-strong); }\n  .quiet-link:hover { color: var(--ink); }\n  .input-row:focus-within { border-color: var(--teal-soft); box-shadow: 0 0 0 1px var(--teal-soft); }\n  .primary-button:hover { background: #3a8176; }\n  .primary-button:active, .outline-button:active { transform: translateY(1px); }\n  .outline-button:hover { border-color: var(--ink); color: var(--ink); }\n  @media (max-width: 899px) {\n    .auth-grid { grid-template-columns: 1fr !important; }\n    .auth-copy { border-bottom: 1px solid var(--rule); padding-bottom: 3rem; }\n    .form-grid { grid-template-columns: 1fr !important; }\n    .form-grid > form + form { border-left: 0 !important; border-top: 1px solid var(--rule); padding-left: 0 !important; padding-top: 2rem; }\n  }\n  @media (prefers-reduced-motion: reduce) { .primary-button, .outline-button, .quiet-link { transition: none !important; } }\n</style>\n<div class=\"auth-page min-h-screen w-full bg-[var(--bg)]\" data-kid=\"1\" data-name=\"authentication page container\" id=\"auth-surface\">\n    <header aria-label=\"T&C Lens AI header\" class=\"border-b hairline\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-16 max-w-[960px] items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a aria-label=\"T&C Lens home\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and workspace link\" href=\"#auth-surface\">\n                <span class=\"flex h-6 w-6 items-center justify-center border rule-strong text-[var(--ink)]\" data-kid=\"1-1-1-1-1\" data-name=\"scan line icon container\">\n                    <i aria-hidden=\"true\" class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"scan-line\" data-name=\"scan line icon\">\n                    </i>\n                </span>\n                <span class=\"mono text-[11px] font-medium uppercase tracking-[0.2em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name and suffix container\">\n                    T&C LENS\n                    <span class=\"text-[var(--teal-soft)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand suffix\">\n                        AI\n                    </span>\n                </span>\n            </a>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-1-1-2\" data-name=\"header navigation and service status container\">\n                <a class=\"quiet-link mono hidden text-[10px] uppercase tracking-[0.14em] text-[var(--dim)] transition-colors sm:inline\" data-kid=\"1-1-1-2-1\" data-name=\"security link\" href=\"#security\">\n                    Security\n                </a>\n                <a class=\"quiet-link mono hidden text-[10px] uppercase tracking-[0.14em] text-[var(--dim)] transition-colors sm:inline\" data-kid=\"1-1-1-2-2\" data-name=\"support link\" href=\"#support\">\n                    Support\n                </a>\n                <span class=\"mono flex items-center gap-2 border hairline px-3 py-2 text-[9px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-1-1-2-3\" data-name=\"service status indicator\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--teal-soft)]\" data-kid=\"1-1-1-2-3-1\" data-name=\"online status dot\">\n                    </span>\n                    Service online\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[960px] px-6 py-20 sm:py-28\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"auth-grid grid gap-16 lg:grid-cols-[0.88fr_1.42fr] lg:gap-20\" data-kid=\"1-2-1\" data-name=\"authentication layout grid\">\n            <section aria-labelledby=\"auth-brief-title\" class=\"auth-copy flex flex-col justify-between\" data-kid=\"1-2-1-1\" data-name=\"assurance information section\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"assurance header area\">\n                    <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"assurance step label\">\n                        01 - Access brief\n                    </div>\n                    <h1 class=\"mt-6 max-w-[360px] text-[42px] font-medium leading-[1.02] tracking-[-0.055em] sm:text-[52px]\" data-kid=\"1-2-1-1-1-2\" data-name=\"assurance headline\" id=\"auth-brief-title\">\n                        Read the fine print.\n                        <br data-kid=\"1-2-1-1-1-2-1\" data-name=\"assurance line break\"/>\n                        <span class=\"text-[var(--muted)]\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"assurance headline subtext\">\n                            Keep the keys.\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[360px] text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-2-1-1-1-3\" data-name=\"assurance description text\">\n                        A hosted way to understand Terms & Conditions without handing over an API key. Your account is the only thing you need to start an analysis.\n                    </p>\n                </div>\n                <div class=\"mt-14 border-t hairline pt-6\" data-kid=\"1-2-1-1-2\" data-name=\"features list section\">\n                    <div class=\"mono mb-5 text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"features list title\">\n                        What is included\n                    </div>\n                    <div class=\"space-y-5\" data-kid=\"1-2-1-1-2-2\" data-name=\"features list\">\n                        <div class=\"flex gap-3\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"feature item 1\">\n                            <i aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--teal-soft)]\" data-kid=\"1-2-1-1-2-2-1-1\" data-lucide=\"badge-check\" data-name=\"feature 1 checkmark icon\">\n                            </i>\n                            <div data-kid=\"1-2-1-1-2-2-1-2\" data-name=\"feature 1 details\">\n                                <div class=\"text-sm font-medium\" data-kid=\"1-2-1-1-2-2-1-2-1\" data-name=\"feature 1 title\">\n                                    No API key needed. Just sign in.\n                                </div>\n                                <div class=\"mt-1 text-xs leading-5 text-[var(--dim)]\" data-kid=\"1-2-1-1-2-2-1-2-2\" data-name=\"feature 1 description\">\n                                    Supabase Auth keeps access simple and scoped.\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex gap-3\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"feature item 2\">\n                            <i aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--teal-soft)]\" data-kid=\"1-2-1-1-2-2-2-1\" data-lucide=\"credit-card\" data-name=\"feature 2 credit card icon\">\n                            </i>\n                            <div data-kid=\"1-2-1-1-2-2-2-2\" data-name=\"feature 2 details\">\n                                <div class=\"text-sm font-medium\" data-kid=\"1-2-1-1-2-2-2-2-1\" data-name=\"feature 2 title\">\n                                    No subscriptions\n                                </div>\n                                <div class=\"mt-1 text-xs leading-5 text-[var(--dim)]\" data-kid=\"1-2-1-1-2-2-2-2-2\" data-name=\"feature 2 description\">\n                                    Buy credits only when you need them.\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex gap-3\" data-kid=\"1-2-1-1-2-2-3\" data-name=\"feature item 3\">\n                            <i aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--teal-soft)]\" data-kid=\"1-2-1-1-2-2-3-1\" data-lucide=\"shield-check\" data-name=\"feature 3 shield icon\">\n                            </i>\n                            <div data-kid=\"1-2-1-1-2-2-3-2\" data-name=\"feature 3 details\">\n                                <div class=\"text-sm font-medium\" data-kid=\"1-2-1-1-2-2-3-2-1\" data-name=\"feature 3 title\">\n                                    Small, deliberate surface\n                                </div>\n                                <div class=\"mt-1 text-xs leading-5 text-[var(--dim)]\" data-kid=\"1-2-1-1-2-2-3-2-2\" data-name=\"feature 3 description\">\n                                    No telemetry. No background activity.\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-14 border-t hairline pt-5\" data-kid=\"1-2-1-1-3\" data-name=\"footer action area\">\n                    <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-1-1-3-1\" data-name=\"free credit info container\">\n                        <span class=\"mono text-[10px] uppercase tracking-[0.14em] text-[var(--amber)]\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"free credit label\">\n                            Free credit · 01\n                        </span>\n                        <span class=\"text-xs text-[var(--dim)]\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"free credit details text\">\n                            One credit on signup\n                        </span>\n                    </div>\n                    <a class=\"quiet-link mt-5 inline-flex items-center gap-2 text-xs text-[var(--muted)] transition-colors\" data-kid=\"1-2-1-1-3-2\" data-name=\"privacy link\" href=\"#privacy\">\n                        <i aria-hidden=\"true\" class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-1-3-2-1\" data-lucide=\"arrow-up-right\" data-name=\"privacy link icon\">\n                        </i>\n                        Privacy-first by default\n                    </a>\n                </div>\n            </section>\n            <section aria-labelledby=\"auth-workspace-title\" data-kid=\"1-2-1-2\" data-name=\"authentication form section\">\n                <div class=\"border-b hairline pb-6\" data-kid=\"1-2-1-2-1\" data-name=\"authentication section header\">\n                    <div class=\"flex items-end justify-between gap-4\" data-kid=\"1-2-1-2-1-1\" data-name=\"authentication header layout container\">\n                        <div data-kid=\"1-2-1-2-1-1-1\" data-name=\"authentication header title area\">\n                            <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"authentication header step label\">\n                                02 - Identity check\n                            </div>\n                            <h2 class=\"mt-5 text-[34px] font-medium tracking-[-0.05em]\" data-kid=\"1-2-1-2-1-1-1-2\" data-name=\"authentication header title\" id=\"auth-workspace-title\">\n                                Enter the workspace.\n                            </h2>\n                        </div>\n                        <span class=\"mono hidden border hairline px-3 py-2 text-[9px] uppercase tracking-[0.14em] text-[var(--muted)] sm:inline\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"auth provider badge\">\n                            Supabase Auth\n                        </span>\n                    </div>\n                    <p class=\"mt-4 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-1-2-1-2\" data-name=\"authentication header description\">\n                        One account for analysis, credit balance, and history.\n                    </p>\n                </div>\n                <div aria-label=\"Authentication mode\" class=\"mt-8 flex border-b hairline\" data-kid=\"1-2-1-2-2\" data-name=\"authentication mode toggle\" role=\"tablist\">\n                    <button aria-selected=\"true\" class=\"border-b-2 border-[var(--teal-soft)] px-0 pb-4 pr-8 text-[11px] font-semibold tracking-[0.16em] text-[var(--ink)]\" data-kid=\"1-2-1-2-2-1\" data-name=\"sign in tab button\" role=\"tab\" type=\"button\">\n                        SIGN IN\n                    </button>\n                    <button aria-selected=\"false\" class=\"px-0 pb-4 pr-8 text-[11px] font-semibold tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-2-1-2-2-2\" data-name=\"create account tab button\" role=\"tab\" type=\"button\">\n                        CREATE ACCOUNT\n                    </button>\n                </div>\n                <div class=\"form-grid mt-8 grid gap-8 xl:grid-cols-2\" data-kid=\"1-2-1-2-3\" data-name=\"auth forms grid\">\n                    <form aria-labelledby=\"signin-title\" class=\"border border-[var(--teal)] bg-[var(--surface)] p-6\" data-kid=\"1-2-1-2-3-1\" data-name=\"sign in form\">\n                        <div class=\"flex items-start justify-between\" data-kid=\"1-2-1-2-3-1-1\" data-name=\"sign in form header\">\n                            <div data-kid=\"1-2-1-2-3-1-1-1\" data-name=\"sign in title area\">\n                                <div class=\"mono text-[10px] uppercase tracking-[0.16em] text-[var(--teal-soft)]\" data-kid=\"1-2-1-2-3-1-1-1-1\" data-name=\"sign in state label\">\n                                    Primary state\n                                </div>\n                                <h3 class=\"mt-4 text-xl font-medium\" data-kid=\"1-2-1-2-3-1-1-1-2\" data-name=\"sign in title\" id=\"signin-title\">\n                                    Sign in\n                                </h3>\n                            </div>\n                            <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--teal-soft)]\" data-kid=\"1-2-1-2-3-1-1-2\" data-lucide=\"log-in\" data-name=\"sign in icon\">\n                            </i>\n                        </div>\n                        <div class=\"mt-8 space-y-6\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"sign in input fields\">\n                            <div data-kid=\"1-2-1-2-3-1-2-1\" data-name=\"email input container\">\n                                <label class=\"mono mb-2 block text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-1-2-1-1\" data-name=\"email label\" for=\"signin-email\">\n                                    Email address\n                                </label>\n                                <div class=\"input-row flex items-center gap-3 border hairline bg-[var(--bg)] px-3 py-3 transition-[border-color,box-shadow]\" data-kid=\"1-2-1-2-3-1-2-1-2\" data-name=\"email input wrapper\">\n                                    <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--dim)]\" data-kid=\"1-2-1-2-3-1-2-1-2-1\" data-lucide=\"mail\" data-name=\"email icon\">\n                                    </i>\n                                    <input autocomplete=\"email\" class=\"min-w-0 flex-1 bg-transparent text-sm text-[var(--ink)] outline-hidden placeholder:text-[var(--dim)]\" data-kid=\"1-2-1-2-3-1-2-1-2-2\" data-name=\"email input\" id=\"signin-email\" placeholder=\"you@example.com\" type=\"email\"/>\n                                </div>\n                                <div class=\"mt-2 text-[11px] text-[var(--dim)]\" data-kid=\"1-2-1-2-3-1-2-1-3\" data-name=\"email help text\">\n                                    Use the email attached to your T&C Lens account.\n                                </div>\n                            </div>\n                            <div data-kid=\"1-2-1-2-3-1-2-2\" data-name=\"password input container\">\n                                <label class=\"mono mb-2 block text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-1-2-2-1\" data-name=\"password label\" for=\"signin-password\">\n                                    Password\n                                </label>\n                                <div class=\"input-row flex items-center gap-3 border hairline bg-[var(--bg)] px-3 py-3 transition-[border-color,box-shadow]\" data-kid=\"1-2-1-2-3-1-2-2-2\" data-name=\"password input wrapper\">\n                                    <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--dim)]\" data-kid=\"1-2-1-2-3-1-2-2-2-1\" data-lucide=\"key-round\" data-name=\"password icon\">\n                                    </i>\n                                    <input autocomplete=\"current-password\" class=\"min-w-0 flex-1 bg-transparent text-sm text-[var(--ink)] outline-hidden placeholder:text-[var(--dim)]\" data-kid=\"1-2-1-2-3-1-2-2-2-2\" data-name=\"password input\" id=\"signin-password\" placeholder=\"Enter password\" type=\"password\"/>\n                                    <button aria-label=\"Show password\" class=\"text-[var(--dim)]\" data-kid=\"1-2-1-2-3-1-2-2-2-3\" data-name=\"password visibility toggle\" type=\"button\">\n                                        <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-2-1-2-3-1-2-2-2-3-1\" data-lucide=\"eye\" data-name=\"eye icon\">\n                                        </i>\n                                    </button>\n                                </div>\n                                <div class=\"mt-2 flex justify-between gap-4 text-[11px] text-[var(--dim)]\" data-kid=\"1-2-1-2-3-1-2-2-3\" data-name=\"password help text container\">\n                                    <span data-kid=\"1-2-1-2-3-1-2-2-3-1\" data-name=\"password length requirement\">\n                                        Minimum 8 characters.\n                                    </span>\n                                    <a class=\"quiet-link text-[var(--teal-soft)] transition-colors\" data-kid=\"1-2-1-2-3-1-2-2-3-2\" data-name=\"forgot password link\" href=\"#reset\">\n                                        Forgot password?\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"primary-button mt-8 flex w-full items-center justify-between bg-[var(--teal)] px-4 py-3.5 text-left text-[11px] font-semibold tracking-[0.16em] text-[var(--ink)] transition-colors\" data-kid=\"1-2-1-2-3-1-3\" data-name=\"sign in submit button\" type=\"submit\">\n                            <span data-kid=\"1-2-1-2-3-1-3-1\" data-name=\"submit button text\">\n                                SIGN IN\n                            </span>\n                            <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-2-1-2-3-1-3-2\" data-lucide=\"arrow-right\" data-name=\"submit button icon\">\n                            </i>\n                        </button>\n                        <div class=\"mono mt-4 flex items-center justify-center gap-2 text-[9px] uppercase tracking-[0.12em] text-[var(--dim)]\" data-kid=\"1-2-1-2-3-1-4\" data-name=\"encrypted status container\">\n                            <i aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"1-2-1-2-3-1-4-1\" data-lucide=\"lock-keyhole\" data-name=\"lock icon\">\n                            </i>\n                            Encrypted sign-in\n                        </div>\n                    </form>\n                    <form aria-labelledby=\"signup-title\" class=\"border-l hairline pl-8\" data-kid=\"1-2-1-2-3-2\" data-name=\"create account form\">\n                        <div class=\"flex items-start justify-between\" data-kid=\"1-2-1-2-3-2-1\" data-name=\"create account form header\">\n                            <div data-kid=\"1-2-1-2-3-2-1-1\" data-name=\"create account title area\">\n                                <div class=\"mono text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-1-1-1\" data-name=\"create account state label\">\n                                    Alternate state\n                                </div>\n                                <h3 class=\"mt-4 text-xl font-medium\" data-kid=\"1-2-1-2-3-2-1-1-2\" data-name=\"create account title\" id=\"signup-title\">\n                                    Create account\n                                </h3>\n                            </div>\n                            <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-1-2\" data-lucide=\"user-round-plus\" data-name=\"create account icon\">\n                            </i>\n                        </div>\n                        <div class=\"mt-8 space-y-5\" data-kid=\"1-2-1-2-3-2-2\" data-name=\"create account input fields\">\n                            <div data-kid=\"1-2-1-2-3-2-2-1\" data-name=\"create email input container\">\n                                <label class=\"mono mb-2 block text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-2-2-1-1\" data-name=\"create email label\" for=\"signup-email\">\n                                    Email address\n                                </label>\n                                <div class=\"input-row flex items-center gap-3 border hairline bg-[var(--surface)] px-3 py-3 transition-[border-color,box-shadow]\" data-kid=\"1-2-1-2-3-2-2-1-2\" data-name=\"create email input wrapper\">\n                                    <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-2-1-2-1\" data-lucide=\"mail\" data-name=\"create email icon\">\n                                    </i>\n                                    <input autocomplete=\"email\" class=\"min-w-0 flex-1 bg-transparent text-sm text-[var(--ink)] outline-hidden placeholder:text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-2-1-2-2\" data-name=\"create email input\" id=\"signup-email\" placeholder=\"you@example.com\" type=\"email\"/>\n                                </div>\n                            </div>\n                            <div data-kid=\"1-2-1-2-3-2-2-2\" data-name=\"create password input container\">\n                                <label class=\"mono mb-2 block text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-2-2-2-1\" data-name=\"create password label\" for=\"signup-password\">\n                                    Password\n                                </label>\n                                <div class=\"input-row flex items-center gap-3 border hairline bg-[var(--surface)] px-3 py-3 transition-[border-color,box-shadow]\" data-kid=\"1-2-1-2-3-2-2-2-2\" data-name=\"create password input wrapper\">\n                                    <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-2-2-2-1\" data-lucide=\"key-round\" data-name=\"create password icon\">\n                                    </i>\n                                    <input autocomplete=\"new-password\" class=\"min-w-0 flex-1 bg-transparent text-sm text-[var(--ink)] outline-hidden placeholder:text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-2-2-2-2\" data-name=\"create password input\" id=\"signup-password\" placeholder=\"Create password\" type=\"password\"/>\n                                </div>\n                                <div class=\"mt-2 text-[11px] text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-2-2-3\" data-name=\"create password help text\">\n                                    Use 8+ characters.\n                                </div>\n                            </div>\n                            <div data-kid=\"1-2-1-2-3-2-2-3\" data-name=\"confirm password input container\">\n                                <label class=\"mono mb-2 block text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-2-2-3-1\" data-name=\"confirm password label\" for=\"signup-confirm\">\n                                    Confirm password\n                                </label>\n                                <div class=\"input-row flex items-center gap-3 border hairline bg-[var(--surface)] px-3 py-3 transition-[border-color,box-shadow]\" data-kid=\"1-2-1-2-3-2-2-3-2\" data-name=\"confirm password input wrapper\">\n                                    <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-2-3-2-1\" data-lucide=\"check-check\" data-name=\"confirm password icon\">\n                                    </i>\n                                    <input autocomplete=\"new-password\" class=\"min-w-0 flex-1 bg-transparent text-sm text-[var(--ink)] outline-hidden placeholder:text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-2-3-2-2\" data-name=\"confirm password input\" id=\"signup-confirm\" placeholder=\"Repeat password\" type=\"password\"/>\n                                </div>\n                                <div class=\"mt-2 text-[11px] text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-2-3-3\" data-name=\"confirm password help text\">\n                                    Confirmation must match.\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"outline-button mt-8 flex w-full items-center justify-between border rule-strong px-4 py-3.5 text-left text-[11px] font-semibold tracking-[0.16em] text-[var(--muted)] transition-colors\" data-kid=\"1-2-1-2-3-2-3\" data-name=\"create account submit button\" type=\"submit\">\n                            <span data-kid=\"1-2-1-2-3-2-3-1\" data-name=\"create account button text\">\n                                CREATE ACCOUNT\n                            </span>\n                            <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-2-1-2-3-2-3-2\" data-lucide=\"user-round-plus\" data-name=\"create account button icon\">\n                            </i>\n                        </button>\n                        <div class=\"mt-4 text-center text-[11px] text-[var(--dim)]\" data-kid=\"1-2-1-2-3-2-4\" data-name=\"create account footer text\">\n                            Includes\n                            <span class=\"text-[var(--amber)]\" data-kid=\"1-2-1-2-3-2-4-1\" data-name=\"create account credit text\">\n                                1 free credit on signup\n                            </span>\n                        </div>\n                    </form>\n                </div>\n                <div class=\"mt-10 border-y hairline py-5\" data-kid=\"1-2-1-2-4\" data-name=\"billing note area\">\n                    <div class=\"flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-1-2-4-1\" data-name=\"billing note container\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2-4-1-1\" data-name=\"billing note icon\">\n                            <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--amber)]\" data-kid=\"1-2-1-2-4-1-1-1\" data-lucide=\"credit-card\" data-name=\"billing note credit card icon\">\n                            </i>\n                            <span class=\"mono text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1-1-2\" data-name=\"billing note label\">\n                                Stripe Checkout\n                            </span>\n                        </div>\n                        <span class=\"text-xs text-[var(--dim)]\" data-kid=\"1-2-1-2-4-1-2\" data-name=\"billing note details\">\n                            Buy credits only when you need them.\n                        </span>\n                        <button class=\"mono border hairline px-3 py-2 text-[9px] uppercase tracking-[0.13em] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-4-1-3\" data-name=\"loading indicator button\" data-reason=\"text and state changed to loading spinner by authentication script\" disabled=\"\" type=\"button\">\n                            AUTHENTICATING…\n                        </button>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n    <footer class=\"border-t hairline\" data-kid=\"1-3\" data-name=\"footer bar\">\n        <div class=\"mx-auto flex max-w-[960px] flex-col gap-3 px-6 py-6 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1\" data-name=\"footer metadata container\">\n            <span class=\"mono text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-3-1-1\" data-name=\"footer brand metadata\">\n                T&C LENS AI / AUTH SURFACE / 2026\n            </span>\n            <span class=\"mono text-[10px] uppercase tracking-[0.14em] text-[var(--dim)]\" data-kid=\"1-3-1-2\" data-name=\"footer service info label\">\n                One-time credits · Supabase Auth · Stripe Checkout\n            </span>\n        </div>\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
      "comments": [],
      "created": "2026-07-28T22:39:52.394694+00:00",
      "modified": "2026-07-28T22:50:38.139476+00:00",
      "id": "var_3aec8e9fd2bd",
      "viewportScrollY": 0
    },
    "var_b94ff74c7101": {
      "type": "variant",
      "label": "T&C Lens AI - Landing Page",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600&display=swap');\n:root {\n  --bg: #0d0f10;\n  --surface: #131617;\n  --surface-2: #171b1d;\n  --ink: #eff2f1;\n  --muted: #7b858a;\n  --dim: #586267;\n  --rule: #262c2f;\n  --rule-strong: #343c40;\n  --amber: #d99b36;\n  --amber-soft: #2b2114;\n  --green: #81b9a3;\n}\nhtml { scroll-behavior: smooth; }\nbody { background: var(--bg); color: var(--ink); font-family: 'Outfit', sans-serif; }\n.mono { font-family: 'JetBrains Mono', monospace; }\n.section-rule { border-color: var(--rule); }\n.fade-rule { background: linear-gradient(90deg, transparent, var(--rule), transparent); height: 1px; }\n.specimen-grid { background-image: linear-gradient(var(--rule) 1px, transparent 1px), linear-gradient(90deg, var(--rule) 1px, transparent 1px); background-size: 100% 100%, 33.333% 100%; }\n.ledger-grid { background-image: linear-gradient(90deg, var(--rule) 1px, transparent 1px); background-size: 33.333% 100%; }\ninput::placeholder { color: var(--dim); }\nsummary::-webkit-details-marker { display: none; }\nsummary { list-style: none; }\n@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\n</style>\n<div class=\"min-h-screen bg-[var(--bg)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b section-rule\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-16 max-w-[960px] items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"header inner content wrapper\">\n            <a aria-label=\"T&C Lens home\" class=\"group flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"home link\" href=\"#top\">\n                <span class=\"flex h-6 w-6 items-center justify-center border border-[var(--rule-strong)] text-[var(--ink)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"scan-line\" data-name=\"scan line icon\">\n                    </i>\n                </span>\n                <span class=\"mono text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--ink)]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    T&C LENS\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-7\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\">\n                <a class=\"mono hidden text-[10px] uppercase tracking-[0.16em] text-[var(--muted)] transition-colors hover:text-[var(--ink)] sm:inline\" data-kid=\"1-1-1-2-1\" data-name=\"features navigation link\" href=\"#features\">\n                    Features\n                </a>\n                <a class=\"mono hidden text-[10px] uppercase tracking-[0.16em] text-[var(--muted)] transition-colors hover:text-[var(--ink)] sm:inline\" data-kid=\"1-1-1-2-2\" data-name=\"providers navigation link\" href=\"#providers\">\n                    Providers\n                </a>\n                <a class=\"mono hidden text-[10px] uppercase tracking-[0.16em] text-[var(--muted)] transition-colors hover:text-[var(--ink)] sm:inline\" data-kid=\"1-1-1-2-3\" data-name=\"faq navigation link\" href=\"#faq\">\n                    FAQ\n                </a>\n                <a class=\"mono inline-flex items-center gap-2 border border-[var(--rule-strong)] px-3 py-2 text-[10px] uppercase tracking-[0.14em] text-[var(--ink)] transition-colors hover:border-[var(--ink)] hover:bg-[var(--ink)] hover:text-[var(--bg)]\" data-kid=\"1-1-1-2-4\" data-name=\"sign in action button\" href=\"#start\">\n                    Sign in\n                    <i class=\"h-3 w-3\" data-kid=\"1-1-1-2-4-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                    </i>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-label=\"Product preview\" class=\"mx-auto max-w-[960px] px-6 pb-32 pt-[310px] sm:pt-[360px]\" data-kid=\"1-2-1\" data-name=\"product preview section\">\n            <div class=\"border border-[var(--rule)] bg-[var(--surface)]\" data-kid=\"1-2-1-1\" data-name=\"preview card container\">\n                <div class=\"flex flex-col justify-between gap-3 border-b section-rule px-6 py-4 sm:flex-row sm:items-center\" data-kid=\"1-2-1-1-1\" data-name=\"preview header\">\n                    <span class=\"mono text-[10px] uppercase tracking-[0.15em] text-[var(--muted)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"analysis source label\">\n                        Analysis - google.com/policies/terms\n                    </span>\n                    <span class=\"mono text-[10px] uppercase tracking-[0.12em] text-[var(--dim)]\" data-kid=\"1-2-1-1-1-2\" data-name=\"analysis metadata label\">\n                        2026-07-18 · Gemini 2.5 Flash\n                    </span>\n                </div>\n                <div class=\"px-6 py-8 sm:px-8 sm:py-9\" data-kid=\"1-2-1-1-2\" data-name=\"preview body\">\n                    <div class=\"grid gap-8 sm:grid-cols-[1fr_1.14fr] sm:items-end\" data-kid=\"1-2-1-1-2-1\" data-name=\"preview statistics summary\">\n                        <div data-kid=\"1-2-1-1-2-1-1\" data-name=\"risk score column\">\n                            <div class=\"mono text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-2-1-1-2-1-1-1\" data-name=\"risk score label\">\n                                Risk score\n                            </div>\n                            <div class=\"mt-3 flex items-end gap-4\" data-kid=\"1-2-1-1-2-1-1-2\" data-name=\"risk score value row\">\n                                <span class=\"text-6xl font-medium leading-none tracking-[-0.08em] text-[var(--ink)]\" data-kid=\"1-2-1-1-2-1-1-2-1\" data-name=\"risk score number\">\n                                    0\n                                </span>\n                                <span class=\"mono mb-1 text-[10px] uppercase tracking-[0.13em] text-[var(--ink)]\" data-kid=\"1-2-1-1-2-1-1-2-2\" data-name=\"risk severity label\">\n                                    High risk\n                                </span>\n                            </div>\n                            <div class=\"mt-6 h-px w-4/5 bg-[var(--rule)]\" data-kid=\"1-2-1-1-2-1-1-3\" data-name=\"risk bar track\">\n                                <div class=\"h-px w-1/4 bg-[var(--amber)]\" data-kid=\"1-2-1-1-2-1-1-3-1\" data-name=\"risk bar progress\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"border-l-2 border-[var(--amber)] bg-[var(--amber-soft)] px-4 py-3\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"risk warning box\">\n                            <p class=\"mono text-[10px] leading-[1.7] text-[var(--amber)]\" data-kid=\"1-2-1-1-2-1-2-1\" data-name=\"risk warning text\">\n                                HIGH RISK - Significant data collection and liability waiver clauses detected.\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-9 max-w-[720px] text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-2-1-1-2-2\" data-name=\"preview summary description\">\n                        This agreement grants broad rights over user data and content, permits unilateral modification of terms, and limits the company's liability to the greatest extent permitted by law.\n                    </p>\n                    <div class=\"mt-8 border-t section-rule\" data-kid=\"1-2-1-1-2-3\" data-name=\"findings list\">\n                        <article class=\"border-b section-rule py-6\" data-kid=\"1-2-1-1-2-3-1\" data-name=\"first finding article\">\n                            <div class=\"flex items-start justify-between gap-6\" data-kid=\"1-2-1-1-2-3-1-1\" data-name=\"finding title row\">\n                                <h3 class=\"text-base font-medium text-[var(--ink)]\" data-kid=\"1-2-1-1-2-3-1-1-1\" data-name=\"finding title text\">\n                                    Broad Data Harvesting\n                                </h3>\n                                <span class=\"mono shrink-0 text-[10px] uppercase tracking-[0.12em] text-[var(--muted)]\" data-kid=\"1-2-1-1-2-3-1-1-2\" data-name=\"finding severity badge\">\n                                    Medium\n                                </span>\n                            </div>\n                            <p class=\"mt-3 max-w-[740px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-1-1-2-3-1-2\" data-name=\"finding description text\">\n                                Collects search history, location information, and activity on third-party sites and apps - beyond what the core service requires.\n                            </p>\n                            <blockquote class=\"mt-4 border-l border-[var(--rule-strong)] pl-4 font-mono text-[11px] leading-6 text-[var(--dim)]\" data-kid=\"1-2-1-1-2-3-1-3\" data-name=\"finding quote block\">\n                                “We use the information that we collect from all our services for the following purposes: provide our services, maintain & improve our services...”\n                            </blockquote>\n                        </article>\n                        <article class=\"py-6\" data-kid=\"1-2-1-1-2-3-2\" data-name=\"second finding article\">\n                            <div class=\"flex items-start justify-between gap-6\" data-kid=\"1-2-1-1-2-3-2-1\" data-name=\"finding title row\">\n                                <h3 class=\"text-base font-medium text-[var(--ink)]\" data-kid=\"1-2-1-1-2-3-2-1-1\" data-name=\"finding title text\">\n                                    Unilateral Terms Changes\n                                </h3>\n                                <span class=\"mono shrink-0 text-[10px] uppercase tracking-[0.12em] text-[var(--ink)]\" data-kid=\"1-2-1-1-2-3-2-1-2\" data-name=\"finding severity badge\">\n                                    High\n                                </span>\n                            </div>\n                            <p class=\"mt-3 max-w-[740px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-1-1-2-3-2-2\" data-name=\"finding description text\">\n                                Terms may be modified at any time; continued use constitutes acceptance. No obligation to notify users individually.\n                            </p>\n                            <blockquote class=\"mt-4 border-l border-[var(--rule-strong)] pl-4 font-mono text-[11px] leading-6 text-[var(--dim)]\" data-kid=\"1-2-1-1-2-3-2-3\" data-name=\"finding quote block\">\n                                “We may modify these terms or any additional terms that apply to a Service to, for example, reflect changes to the law or changes to our Services...”\n                            </blockquote>\n                        </article>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"fade-rule\" data-kid=\"1-2-2\" data-name=\"horizontal rule spacer\">\n        </div>\n        <section class=\"mx-auto max-w-[960px] px-6 py-28 sm:py-36\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n            <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-2-3-1\" data-name=\"how it works section label\">\n                01 - How it works\n            </div>\n            <h2 class=\"mt-5 text-3xl font-medium tracking-[-0.04em] text-[var(--ink)] sm:text-[40px]\" data-kid=\"1-2-3-2\" data-name=\"how it works section headline\">\n                Four steps. One click.\n            </h2>\n            <div class=\"mt-14 grid border border-[var(--rule)] sm:grid-cols-2\" data-kid=\"1-2-3-3\" data-name=\"how it works steps grid\">\n                <article class=\"border-b section-rule p-7 sm:border-r sm:p-8\" data-kid=\"1-2-3-3-1\" data-name=\"step one article\">\n                    <div class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3-1-1\" data-name=\"step one icon container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-1-1-1\" data-lucide=\"mouse-pointer-2\" data-name=\"mouse pointer icon\">\n                        </i>\n                    </div>\n                    <div class=\"mono mt-7 text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-2-3-3-1-2\" data-name=\"step one title\">\n                        01. Activate\n                    </div>\n                    <p class=\"mt-4 max-w-[320px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-3-3-1-3\" data-name=\"step one description\">\n                        Click the extension on any legal page - or right-click → Analyze with T&C Lens.\n                    </p>\n                </article>\n                <article class=\"border-b section-rule p-7 sm:p-8\" data-kid=\"1-2-3-3-2\" data-name=\"step two article\">\n                    <div class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3-2-1\" data-name=\"step two icon container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-2-1-1\" data-lucide=\"scan-text\" data-name=\"scan text icon\">\n                        </i>\n                    </div>\n                    <div class=\"mono mt-7 text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-2-3-3-2-2\" data-name=\"step two title\">\n                        02. Scrape\n                    </div>\n                    <p class=\"mt-4 max-w-[320px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-3-3-2-3\" data-name=\"step two description\">\n                        Smart extraction targets legal text, skipping navigation, footers, and cookie banners.\n                    </p>\n                </article>\n                <article class=\"border-b section-rule p-7 sm:border-r sm:p-8\" data-kid=\"1-2-3-3-3\" data-name=\"step three article\">\n                    <div class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3-3-1\" data-name=\"step three icon container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-3-1-1\" data-lucide=\"cpu\" data-name=\"cpu icon\">\n                        </i>\n                    </div>\n                    <div class=\"mono mt-7 text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-2-3-3-3-2\" data-name=\"step three title\">\n                        03. Analyze\n                    </div>\n                    <p class=\"mt-4 max-w-[320px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-3-3-3-3\" data-name=\"step three description\">\n                        Text is sent to your chosen AI provider. Nothing touches our servers.\n                    </p>\n                </article>\n                <article class=\"p-7 sm:p-8\" data-kid=\"1-2-3-3-4\" data-name=\"step four article\">\n                    <div class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3-4-1\" data-name=\"step four icon container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-4-1-1\" data-lucide=\"bar-chart-3\" data-name=\"bar chart icon\">\n                        </i>\n                    </div>\n                    <div class=\"mono mt-7 text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-2-3-3-4-2\" data-name=\"step four title\">\n                        04. Review\n                    </div>\n                    <p class=\"mt-4 max-w-[320px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-3-3-4-3\" data-name=\"step four description\">\n                        Get a 0-100 risk score, a plain-English summary, and quoted findings.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <div class=\"fade-rule\" data-kid=\"1-2-4\" data-name=\"horizontal rule spacer\">\n        </div>\n        <section class=\"mx-auto max-w-[960px] px-6 py-28 sm:py-36\" data-kid=\"1-2-5\" data-name=\"providers section\" id=\"providers\">\n            <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-2-5-1\" data-name=\"providers section label\">\n                02 - Providers\n            </div>\n            <h2 class=\"mt-5 text-3xl font-medium tracking-[-0.04em] text-[var(--ink)] sm:text-[40px]\" data-kid=\"1-2-5-2\" data-name=\"providers section headline\">\n                Bring your own key.\n            </h2>\n            <p class=\"mt-5 max-w-[600px] text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-2-5-3\" data-name=\"providers section description\">\n                Works with 9 providers. Use free tiers or your existing API keys. Your key stays in local storage.\n            </p>\n            <div class=\"ledger-grid mt-12 grid border border-[var(--rule)] sm:grid-cols-3\" data-kid=\"1-2-5-4\" data-name=\"providers list grid\">\n                <div class=\"flex items-center justify-between border-b section-rule px-6 py-5 sm:border-r\" data-kid=\"1-2-5-4-1\" data-name=\"provider item one\">\n                    <span class=\"mono text-xs text-[var(--ink)]\" data-kid=\"1-2-5-4-1-1\" data-name=\"provider name text\">\n                        Gemini\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--muted)]\" data-kid=\"1-2-5-4-1-2\" data-name=\"provider status text\">\n                        Free tier\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between border-b section-rule px-6 py-5 sm:border-r\" data-kid=\"1-2-5-4-2\" data-name=\"provider item two\">\n                    <span class=\"mono text-xs text-[var(--ink)]\" data-kid=\"1-2-5-4-2-1\" data-name=\"provider name text\">\n                        Groq\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--muted)]\" data-kid=\"1-2-5-4-2-2\" data-name=\"provider status text\">\n                        Free tier\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between border-b section-rule px-6 py-5\" data-kid=\"1-2-5-4-3\" data-name=\"provider item three\">\n                    <span class=\"mono text-xs text-[var(--ink)]\" data-kid=\"1-2-5-4-3-1\" data-name=\"provider name text\">\n                        DeepSeek\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--muted)]\" data-kid=\"1-2-5-4-3-2\" data-name=\"provider status text\">\n                        Free tier\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between border-b section-rule px-6 py-5 sm:border-r\" data-kid=\"1-2-5-4-4\" data-name=\"provider item four\">\n                    <span class=\"mono text-xs text-[var(--ink)]\" data-kid=\"1-2-5-4-4-1\" data-name=\"provider name text\">\n                        OpenRouter\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--muted)]\" data-kid=\"1-2-5-4-4-2\" data-name=\"provider status text\">\n                        Free tier\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between border-b section-rule px-6 py-5 sm:border-r\" data-kid=\"1-2-5-4-5\" data-name=\"provider item five\">\n                    <span class=\"mono text-xs text-[var(--ink)]\" data-kid=\"1-2-5-4-5-1\" data-name=\"provider name text\">\n                        Together AI\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--muted)]\" data-kid=\"1-2-5-4-5-2\" data-name=\"provider status text\">\n                        Free tier\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between border-b section-rule px-6 py-5\" data-kid=\"1-2-5-4-6\" data-name=\"provider item six\">\n                    <span class=\"mono text-xs text-[var(--dim)]\" data-kid=\"1-2-5-4-6-1\" data-name=\"provider name text\">\n                        Mistral\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--dim)]\" data-kid=\"1-2-5-4-6-2\" data-name=\"provider status text\">\n                        -\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between px-6 py-5 sm:border-r\" data-kid=\"1-2-5-4-7\" data-name=\"provider item seven\">\n                    <span class=\"mono text-xs text-[var(--dim)]\" data-kid=\"1-2-5-4-7-1\" data-name=\"provider name text\">\n                        OpenAI\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--dim)]\" data-kid=\"1-2-5-4-7-2\" data-name=\"provider status text\">\n                        -\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between px-6 py-5 sm:border-r\" data-kid=\"1-2-5-4-8\" data-name=\"provider item eight\">\n                    <span class=\"mono text-xs text-[var(--dim)]\" data-kid=\"1-2-5-4-8-1\" data-name=\"provider name text\">\n                        Anthropic\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--dim)]\" data-kid=\"1-2-5-4-8-2\" data-name=\"provider status text\">\n                        -\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between px-6 py-5\" data-kid=\"1-2-5-4-9\" data-name=\"provider item nine\">\n                    <span class=\"mono text-xs text-[var(--dim)]\" data-kid=\"1-2-5-4-9-1\" data-name=\"provider name text\">\n                        xAI\n                    </span>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.13em] text-[var(--dim)]\" data-kid=\"1-2-5-4-9-2\" data-name=\"provider status text\">\n                        -\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-8 border-y section-rule py-5\" data-kid=\"1-2-5-5\" data-name=\"hosted ai info box\">\n                <div class=\"flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between\" data-kid=\"1-2-5-5-1\" data-name=\"hosted ai content layout\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-5-5-1-1\" data-name=\"hosted ai title layout\">\n                        <span class=\"flex h-7 w-7 items-center justify-center border border-[var(--amber)] text-[var(--amber)]\" data-kid=\"1-2-5-5-1-1-1\" data-name=\"hosted ai icon container\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-5-5-1-1-1-1\" data-lucide=\"credit-card\" data-name=\"credit card icon\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-2-5-5-1-1-2\" data-name=\"hosted ai title column\">\n                            <div class=\"mono text-[10px] uppercase tracking-[0.16em] text-[var(--ink)]\" data-kid=\"1-2-5-5-1-1-2-1\" data-name=\"hosted ai label\">\n                                T&C Lens AI - hosted\n                            </div>\n                            <div class=\"mt-1 text-xs text-[var(--muted)]\" data-kid=\"1-2-5-5-1-1-2-2\" data-name=\"hosted ai subtext\">\n                                1 free credit on signup · No subscriptions\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-wrap gap-x-7 gap-y-2 lg:justify-end\" data-kid=\"1-2-5-5-1-2\" data-name=\"hosted ai pricing options\">\n                        <span class=\"mono text-[10px] text-[var(--muted)]\" data-kid=\"1-2-5-5-1-2-1\" data-name=\"pricing option one\">\n                            <b class=\"font-medium text-[var(--ink)]\" data-kid=\"1-2-5-5-1-2-1-1\" data-name=\"pricing amount\">\n                                $2\n                            </b>\n                            / 25 credits\n                        </span>\n                        <span class=\"mono text-[10px] text-[var(--muted)]\" data-kid=\"1-2-5-5-1-2-2\" data-name=\"pricing option two\">\n                            <b class=\"font-medium text-[var(--ink)]\" data-kid=\"1-2-5-5-1-2-2-1\" data-name=\"pricing amount\">\n                                $5\n                            </b>\n                            / 75 credits\n                        </span>\n                        <span class=\"mono text-[10px] text-[var(--muted)]\" data-kid=\"1-2-5-5-1-2-3\" data-name=\"pricing option three\">\n                            <b class=\"font-medium text-[var(--ink)]\" data-kid=\"1-2-5-5-1-2-3-1\" data-name=\"pricing amount\">\n                                $10\n                            </b>\n                            / 200 credits\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"fade-rule\" data-kid=\"1-2-6\" data-name=\"horizontal rule spacer\">\n        </div>\n        <section class=\"mx-auto max-w-[960px] px-6 py-28 sm:py-36\" data-kid=\"1-2-7\" data-name=\"privacy section\" id=\"privacy\">\n            <div class=\"grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-start\" data-kid=\"1-2-7-1\" data-name=\"privacy section grid\">\n                <div data-kid=\"1-2-7-1-1\" data-name=\"privacy info column\">\n                    <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-2-7-1-1-1\" data-name=\"privacy section label\">\n                        03 - Privacy\n                    </div>\n                    <h2 class=\"mt-5 max-w-[480px] text-3xl font-medium leading-[1.07] tracking-[-0.05em] text-[var(--ink)] sm:text-[40px]\" data-kid=\"1-2-7-1-1-2\" data-name=\"privacy section headline\">\n                        Zero telemetry.\n                        <br data-kid=\"1-2-7-1-1-2-1\" data-name=\"headline line break\"/>\n                        Complete privacy.\n                    </h2>\n                    <p class=\"mt-7 max-w-[470px] text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-2-7-1-1-3\" data-name=\"privacy section description\">\n                        No analytics, no tracking, no data collection. Your API key never leaves local storage. The only external request is the one you trigger to your chosen AI.\n                    </p>\n                    <div class=\"mt-9 inline-flex h-14 w-14 items-center justify-center border border-[var(--amber)] text-[var(--amber)]\" data-kid=\"1-2-7-1-1-4\" data-name=\"privacy icon container\">\n                        <i class=\"h-5 w-5\" data-kid=\"1-2-7-1-1-4-1\" data-lucide=\"eye-off\" data-name=\"eye off icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"grid border border-[var(--rule)] sm:grid-cols-2\" data-kid=\"1-2-7-1-2\" data-name=\"privacy details grid\">\n                    <div class=\"border-b section-rule p-6 sm:border-b-0 sm:border-r\" data-kid=\"1-2-7-1-2-1\" data-name=\"local storage box\">\n                        <div class=\"mono text-[10px] uppercase leading-5 tracking-[0.14em] text-[var(--dim)]\" data-kid=\"1-2-7-1-2-1-1\" data-name=\"local storage title\">\n                            What stays on\n                            <br data-kid=\"1-2-7-1-2-1-1-1\" data-name=\"local storage title line break\"/>\n                            your device\n                        </div>\n                        <ul class=\"mt-7 space-y-3 font-mono text-[11px] text-[var(--ink)]\" data-kid=\"1-2-7-1-2-1-2\" data-name=\"local storage list\">\n                            <li data-kid=\"1-2-7-1-2-1-2-1\" data-name=\"list item one\">\n                                + Your API key\n                            </li>\n                            <li data-kid=\"1-2-7-1-2-1-2-2\" data-name=\"list item two\">\n                                + Analysis history\n                            </li>\n                            <li data-kid=\"1-2-7-1-2-1-2-3\" data-name=\"list item three\">\n                                + Your settings\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"p-6\" data-kid=\"1-2-7-1-2-2\" data-name=\"external data box\">\n                        <div class=\"mono text-[10px] uppercase leading-5 tracking-[0.14em] text-[var(--dim)]\" data-kid=\"1-2-7-1-2-2-1\" data-name=\"external data title\">\n                            What gets sent\n                        </div>\n                        <ul class=\"mt-7 space-y-3 font-mono text-[11px] text-[var(--muted)]\" data-kid=\"1-2-7-1-2-2-2\" data-name=\"external data list\">\n                            <li data-kid=\"1-2-7-1-2-2-2-1\" data-name=\"list item one\">\n                                → Legal text, to your AI only\n                            </li>\n                            <li data-kid=\"1-2-7-1-2-2-2-2\" data-name=\"list item two\">\n                                − No analytics\n                            </li>\n                            <li data-kid=\"1-2-7-1-2-2-2-3\" data-name=\"list item three\">\n                                − No telemetry\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"fade-rule\" data-kid=\"1-2-8\" data-name=\"horizontal rule spacer\">\n        </div>\n        <section class=\"mx-auto max-w-[960px] px-6 py-28 sm:py-36\" data-kid=\"1-2-9\" data-name=\"features section\" id=\"features\">\n            <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-2-9-1\" data-name=\"features section label\">\n                04 - Features\n            </div>\n            <h2 class=\"mt-5 text-3xl font-medium tracking-[-0.04em] text-[var(--ink)] sm:text-[40px]\" data-kid=\"1-2-9-2\" data-name=\"features section headline\">\n                No clutter. Just information.\n            </h2>\n            <div class=\"mt-14 border-t section-rule\" data-kid=\"1-2-9-3\" data-name=\"features list\">\n                <article class=\"grid gap-4 border-b section-rule py-7 sm:grid-cols-[1fr_128px] sm:gap-10\" data-kid=\"1-2-9-3-1\" data-name=\"feature article one\">\n                    <div data-kid=\"1-2-9-3-1-1\" data-name=\"feature title and text wrapper\">\n                        <h3 class=\"text-base font-medium text-[var(--ink)]\" data-kid=\"1-2-9-3-1-1-1\" data-name=\"feature title text\">\n                            Smart Extraction\n                        </h3>\n                        <p class=\"mt-3 max-w-[660px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-9-3-1-1-2\" data-name=\"feature description text\">\n                            Intelligent scraper targets legal content specifically, filtering out navigation, headers, footers, and cookie banners.\n                        </p>\n                    </div>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.14em] text-[var(--muted)] sm:pt-1 sm:text-right\" data-kid=\"1-2-9-3-1-2\" data-name=\"feature tag label\">\n                        Core\n                    </span>\n                </article>\n                <article class=\"grid gap-4 border-b section-rule py-7 sm:grid-cols-[1fr_128px] sm:gap-10\" data-kid=\"1-2-9-3-2\" data-name=\"feature article two\">\n                    <div data-kid=\"1-2-9-3-2-1\" data-name=\"feature title and text wrapper\">\n                        <h3 class=\"text-base font-medium text-[var(--ink)]\" data-kid=\"1-2-9-3-2-1-1\" data-name=\"feature title text\">\n                            On-Demand Only\n                        </h3>\n                        <p class=\"mt-3 max-w-[660px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-9-3-2-1-2\" data-name=\"feature description text\">\n                            Fully passive. Does nothing in the background. Runs only when you click.\n                        </p>\n                    </div>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.14em] text-[var(--muted)] sm:pt-1 sm:text-right\" data-kid=\"1-2-9-3-2-2\" data-name=\"feature tag label\">\n                        Passive\n                    </span>\n                </article>\n                <article class=\"grid gap-4 border-b section-rule py-7 sm:grid-cols-[1fr_128px] sm:gap-10\" data-kid=\"1-2-9-3-3\" data-name=\"feature article three\">\n                    <div data-kid=\"1-2-9-3-3-1\" data-name=\"feature title and text wrapper\">\n                        <h3 class=\"text-base font-medium text-[var(--ink)]\" data-kid=\"1-2-9-3-3-1-1\" data-name=\"feature title text\">\n                            History & Export\n                        </h3>\n                        <p class=\"mt-3 max-w-[660px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-9-3-3-1-2\" data-name=\"feature description text\">\n                            Past analyses saved locally. Export any result as a .txt file.\n                        </p>\n                    </div>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.14em] text-[var(--muted)] sm:pt-1 sm:text-right\" data-kid=\"1-2-9-3-3-2\" data-name=\"feature tag label\">\n                        Local\n                    </span>\n                </article>\n                <article class=\"grid gap-4 border-b section-rule py-7 sm:grid-cols-[1fr_128px] sm:gap-10\" data-kid=\"1-2-9-3-4\" data-name=\"feature article four\">\n                    <div data-kid=\"1-2-9-3-4-1\" data-name=\"feature title and text wrapper\">\n                        <h3 class=\"text-base font-medium text-[var(--ink)]\" data-kid=\"1-2-9-3-4-1-1\" data-name=\"feature title text\">\n                            Minimal Dark UI\n                        </h3>\n                        <p class=\"mt-3 max-w-[660px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-9-3-4-1-2\" data-name=\"feature description text\">\n                            Designed to feel like a premium developer tool. No clutter. No colors. Just information.\n                        </p>\n                    </div>\n                    <span class=\"mono text-[9px] uppercase tracking-[0.14em] text-[var(--muted)] sm:pt-1 sm:text-right\" data-kid=\"1-2-9-3-4-2\" data-name=\"feature tag label\">\n                        Design\n                    </span>\n                </article>\n            </div>\n        </section>\n        <div class=\"fade-rule\" data-kid=\"1-2-10\" data-name=\"horizontal rule spacer\">\n        </div>\n        <section class=\"mx-auto max-w-[960px] px-6 py-28 sm:py-36\" data-kid=\"1-2-11\" data-name=\"faq section\" id=\"faq\">\n            <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-2-11-1\" data-name=\"faq section label\">\n                05 - FAQ\n            </div>\n            <h2 class=\"mt-5 text-3xl font-medium tracking-[-0.04em] text-[var(--ink)] sm:text-[40px]\" data-kid=\"1-2-11-2\" data-name=\"faq section headline\">\n                Questions.\n            </h2>\n            <div class=\"mt-14 border-t section-rule\" data-kid=\"1-2-11-3\" data-name=\"faq list container\">\n                <details class=\"group border-b section-rule\" data-kid=\"1-2-11-3-1\" data-name=\"faq item one\">\n                    <summary class=\"flex cursor-pointer items-center justify-between gap-8 py-6 text-sm font-medium text-[var(--ink)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--amber)]\" data-kid=\"1-2-11-3-1-1\" data-name=\"faq question summary\">\n                        Do I need to pay to use T&C Lens?\n                        <span class=\"mono text-base font-normal text-[var(--muted)] group-open:rotate-45\" data-kid=\"1-2-11-3-1-1-1\" data-name=\"plus icon\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[620px] pb-6 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-11-3-1-2\" data-name=\"faq answer text\">\n                        No. The browser extension is free and works with your own AI provider key. T&C Lens AI includes one free credit on signup, then you buy credits only when you need them.\n                    </p>\n                </details>\n                <details class=\"group border-b section-rule\" data-kid=\"1-2-11-3-2\" data-name=\"faq item two\">\n                    <summary class=\"flex cursor-pointer items-center justify-between gap-8 py-6 text-sm font-medium text-[var(--ink)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--amber)]\" data-kid=\"1-2-11-3-2-1\" data-name=\"faq question summary\">\n                        Is my data safe?\n                        <span class=\"mono text-base font-normal text-[var(--muted)] group-open:rotate-45\" data-kid=\"1-2-11-3-2-1-1\" data-name=\"plus icon\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[620px] pb-6 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-11-3-2-2\" data-name=\"faq answer text\">\n                        Your API key and history stay in local storage. Only the legal text is sent to the provider you choose when you click analyze. There is no telemetry or analytics layer.\n                    </p>\n                </details>\n                <details class=\"group border-b section-rule\" data-kid=\"1-2-11-3-3\" data-name=\"faq item three\">\n                    <summary class=\"flex cursor-pointer items-center justify-between gap-8 py-6 text-sm font-medium text-[var(--ink)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--amber)]\" data-kid=\"1-2-11-3-3-1\" data-name=\"faq question summary\">\n                        Does it run in the background?\n                        <span class=\"mono text-base font-normal text-[var(--muted)] group-open:rotate-45\" data-kid=\"1-2-11-3-3-1-1\" data-name=\"plus icon\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[620px] pb-6 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-11-3-3-2\" data-name=\"faq answer text\">\n                        No. T&C Lens is fully on-demand. It does nothing until you click the extension or choose Analyze with T&C Lens from the context menu.\n                    </p>\n                </details>\n                <details class=\"group border-b section-rule\" data-kid=\"1-2-11-3-4\" data-name=\"faq item four\">\n                    <summary class=\"flex cursor-pointer items-center justify-between gap-8 py-6 text-sm font-medium text-[var(--ink)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--amber)]\" data-kid=\"1-2-11-3-4-1\" data-name=\"faq question summary\">\n                        Does it work on Firefox?\n                        <span class=\"mono text-base font-normal text-[var(--muted)] group-open:rotate-45\" data-kid=\"1-2-11-3-4-1-1\" data-name=\"plus icon\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[620px] pb-6 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-11-3-4-2\" data-name=\"faq answer text\">\n                        Yes. T&C Lens supports Chrome Manifest V3 and Firefox with the compatible background-script behavior.\n                    </p>\n                </details>\n            </div>\n        </section>\n        <div class=\"fade-rule\" data-kid=\"1-2-12\" data-name=\"horizontal rule spacer\">\n        </div>\n        <section class=\"mx-auto max-w-[960px] px-6 py-28 sm:py-36\" data-kid=\"1-2-13\" data-name=\"open source section\" id=\"start\">\n            <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-2-13-1\" data-name=\"open source section label\">\n                06 - Open source\n            </div>\n            <h2 class=\"mt-5 text-3xl font-medium tracking-[-0.04em] text-[var(--ink)] sm:text-[40px]\" data-kid=\"1-2-13-2\" data-name=\"open source section headline\">\n                Read the code yourself.\n            </h2>\n            <div class=\"mt-12 flex flex-col gap-5 border border-[var(--rule)] bg-[var(--surface)] px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6\" data-kid=\"1-2-13-3\" data-name=\"git command box\">\n                <code class=\"mono break-all text-[11px] text-[var(--ink)]\" data-kid=\"1-2-13-3-1\" data-name=\"git command code snippet\">\n                    <span class=\"text-[var(--dim)]\" data-kid=\"1-2-13-3-1-1\" data-name=\"git prompt character\">\n                        $\n                    </span>\n                    git clone https://github.com/danieldamilola/T-C.git\n                </code>\n                <button class=\"mono shrink-0 self-start border border-[var(--rule-strong)] px-3 py-2 text-[9px] uppercase tracking-[0.14em] text-[var(--muted)] transition-colors hover:border-[var(--ink)] hover:text-[var(--ink)] sm:self-auto\" data-kid=\"1-2-13-3-2\" data-name=\"copy button\">\n                    Copy\n                </button>\n            </div>\n            <p class=\"mt-6 max-w-[570px] text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-2-13-4\" data-name=\"open source description\">\n                100% open-source under MIT. Inspect the code, verify the privacy claims, or contribute.\n            </p>\n            <a class=\"mt-8 inline-flex items-center gap-3 bg-[var(--ink)] px-5 py-3 text-[10px] font-medium uppercase tracking-[0.14em] text-[var(--bg)] transition-colors hover:bg-[var(--amber)]\" data-kid=\"1-2-13-5\" data-name=\"github call to action button\" href=\"https://github.com/danieldamilola/T-C\">\n                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-13-5-1\" data-lucide=\"github\" data-name=\"github icon\">\n                </i>\n                Star on GitHub\n            </a>\n        </section>\n    </main>\n    <footer class=\"border-t section-rule\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[960px] flex-col gap-5 px-6 py-7 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1\" data-name=\"footer inner content wrapper\">\n            <span class=\"mono text-[10px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-3-1-1\" data-name=\"copyright license text\">\n                ▣ T&C Lens - MIT License\n            </span>\n            <div class=\"flex flex-wrap gap-x-7 gap-y-2\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n                <a class=\"mono text-[10px] uppercase tracking-[0.14em] text-[var(--dim)] transition-colors hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-1\" data-name=\"github link\" href=\"https://github.com/danieldamilola/T-C\">\n                    GitHub\n                </a>\n                <a class=\"mono text-[10px] uppercase tracking-[0.14em] text-[var(--dim)] transition-colors hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-2\" data-name=\"report bug link\" href=\"https://github.com/danieldamilola/T-C/issues\">\n                    Report a bug\n                </a>\n                <a class=\"mono text-[10px] uppercase tracking-[0.14em] text-[var(--dim)] transition-colors hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-3\" data-name=\"request feature link\" href=\"https://github.com/danieldamilola/T-C/issues\">\n                    Request a feature\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
      "comments": [],
      "created": "2026-07-28T22:39:53.919695+00:00",
      "modified": "2026-07-28T22:40:28.618789+00:00",
      "id": "var_b94ff74c7101",
      "viewportScrollY": 4934
    },
    "var_bf13edd4feb5": {
      "type": "variant",
      "label": "T&C Lens AI - Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2920,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600&display=swap');\n  :root {\n    --bg: #0d0f10;\n    --surface: #131617;\n    --surface-2: #171b1d;\n    --ink: #eff2f1;\n    --muted: #7b858a;\n    --dim: #586267;\n    --rule: #262c2f;\n    --rule-strong: #343c40;\n    --teal: #2b6c63;\n    --teal-soft: #8cc5ba;\n    --amber: #d99b36;\n    --amber-soft: #2b2114;\n    --green: #81b9a3;\n    --red: #bd756d;\n  }\n  .dashboard-page { font-family: 'Outfit', sans-serif; background: var(--bg); color: var(--ink); }\n  .mono { font-family: 'JetBrains Mono', monospace; }\n  .hairline { border-color: var(--rule); }\n  .rule-strong { border-color: var(--rule-strong); }\n  .nav-link:hover { color: var(--ink); background: var(--surface); }\n  .nav-link.active { color: var(--ink); border-left-color: var(--teal-soft); background: var(--surface-2); }\n  .primary-button:hover { background: #3a8176; }\n  .primary-button:active, .package-button:active { transform: translateY(1px); }\n  .package-button:hover { border-color: var(--teal-soft); }\n  .package-selected { border-color: var(--teal-soft); background: #162321; }\n  .inputless-link:hover { color: var(--ink); }\n  @media (max-width: 959px) {\n    .app-layout { grid-template-columns: 1fr !important; }\n    .sidebar { position: relative !important; height: auto !important; border-right: 0 !important; border-bottom: 1px solid var(--rule); }\n    .sidebar-nav { display: grid !important; grid-template-columns: repeat(4, 1fr); gap: 0.25rem; }\n    .sidebar-account { display: none !important; }\n    .dashboard-main { padding: 1.5rem !important; }\n    .top-grid, .run-grid, .body-grid { grid-template-columns: 1fr !important; }\n  }\n</style>\n<div class=\"dashboard-page min-h-screen w-full bg-[var(--bg)]\" data-kid=\"1\" data-name=\"shell layout wrapper\" id=\"dashboard-surface\">\n    <div class=\"app-layout grid min-h-screen grid-cols-[210px_1fr]\" data-kid=\"1-1\">\n        <aside class=\"sidebar sticky top-0 flex h-screen flex-col border-r hairline bg-[var(--bg)] px-5 py-6\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3 border-b hairline pb-6\" data-kid=\"1-1-1-1\">\n                <span class=\"flex h-6 w-6 items-center justify-center border rule-strong text-[var(--ink)]\" data-kid=\"1-1-1-1-1\" data-name=\"app logo icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"scan-line\">\n                    </i>\n                </span>\n                <div data-kid=\"1-1-1-1-2\">\n                    <div class=\"mono text-[11px] font-medium uppercase tracking-[0.2em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        T&C LENS\n                    </div>\n                    <div class=\"mono mt-1 text-[9px] uppercase tracking-[0.16em] text-[var(--dim)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        AI / control center\n                    </div>\n                </div>\n            </div>\n            <div class=\"mono mb-3 mt-9 px-3 text-[9px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-1-1-2\">\n                Workspace\n            </div>\n            <nav aria-label=\"Primary navigation\" class=\"sidebar-nav space-y-1\" data-kid=\"1-1-1-3\">\n                <a aria-current=\"page\" class=\"nav-link active flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[11px] font-medium tracking-[0.08em]\" data-kid=\"1-1-1-3-1\" href=\"#dashboard\">\n                    <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-1-1-3-1-1\" data-lucide=\"layout-dashboard\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-1-2\">\n                        DASHBOARD\n                    </span>\n                </a>\n                <a class=\"nav-link flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[11px] font-medium tracking-[0.08em] text-[var(--muted)]\" data-kid=\"1-1-1-3-2\" href=\"#analysis\">\n                    <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-1-1-3-2-1\" data-lucide=\"file-search\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-2-2\">\n                        ANALYSIS\n                    </span>\n                </a>\n                <a class=\"nav-link flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[11px] font-medium tracking-[0.08em] text-[var(--muted)]\" data-kid=\"1-1-1-3-3\" href=\"#history\">\n                    <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-1-1-3-3-1\" data-lucide=\"history\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-3-2\">\n                        HISTORY\n                    </span>\n                </a>\n                <a class=\"nav-link flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[11px] font-medium tracking-[0.08em] text-[var(--muted)]\" data-kid=\"1-1-1-3-4\" href=\"#settings\">\n                    <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-1-1-3-4-1\" data-lucide=\"sliders-horizontal\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-4-2\">\n                        SETTINGS\n                    </span>\n                </a>\n            </nav>\n            <div class=\"sidebar-account mt-auto border-t hairline pt-5\" data-kid=\"1-1-1-4\">\n                <div class=\"mono mb-4 text-[9px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-1-1-4-1\">\n                    Account\n                </div>\n                <div class=\"flex items-start gap-3\" data-kid=\"1-1-1-4-2\">\n                    <span class=\"flex h-7 w-7 items-center justify-center border hairline text-xs text-[var(--teal-soft)]\" data-kid=\"1-1-1-4-2-1\">\n                        D\n                    </span>\n                    <div class=\"min-w-0\" data-kid=\"1-1-1-4-2-2\">\n                        <div class=\"truncate text-xs text-[var(--ink)]\" data-kid=\"1-1-1-4-2-2-1\">\n                            damilola@example.com\n                        </div>\n                        <div class=\"mono mt-1 text-[9px] uppercase tracking-[0.12em] text-[var(--amber)]\" data-kid=\"1-1-1-4-2-2-2\" data-name=\"credit remaining text\">\n                            1 credit remaining\n                        </div>\n                    </div>\n                </div>\n                <button class=\"mt-5 flex w-full items-center justify-between border rule-strong px-3 py-2.5 text-left text-[10px] font-semibold tracking-[0.13em]\" data-kid=\"1-1-1-4-3\" type=\"button\">\n                    BUY CREDITS\n                    <i aria-hidden=\"true\" class=\"h-3.5 w-3.5 text-[var(--teal-soft)]\" data-kid=\"1-1-1-4-3-1\" data-lucide=\"arrow-up-right\">\n                    </i>\n                </button>\n                <div class=\"mono mt-4 flex items-center justify-between text-[9px] uppercase tracking-[0.12em] text-[var(--dim)]\" data-kid=\"1-1-1-4-4\">\n                    <span data-kid=\"1-1-1-4-4-1\">\n                        Supabase Auth\n                    </span>\n                    <span class=\"text-[var(--teal-soft)]\" data-kid=\"1-1-1-4-4-2\" data-name=\"auth status value\">\n                        Active\n                    </span>\n                </div>\n            </div>\n        </aside>\n        <main class=\"dashboard-main min-w-0 px-8 pb-14 pt-7 xl:px-12\" data-kid=\"1-1-2\" id=\"dashboard\">\n            <header class=\"flex items-end justify-between gap-6 border-b hairline pb-6\" data-kid=\"1-1-2-1\">\n                <div data-kid=\"1-1-2-1-1\">\n                    <div class=\"mono flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-1-2-1-1-1\">\n                        <span data-kid=\"1-1-2-1-1-1-1\">\n                            T&C LENS AI\n                        </span>\n                        <span data-kid=\"1-1-2-1-1-1-2\" data-name=\"breadcrumb separator\">\n                            /\n                        </span>\n                        <span class=\"text-[var(--muted)]\" data-kid=\"1-1-2-1-1-1-3\" data-name=\"breadcrumb page name\">\n                            DASHBOARD\n                        </span>\n                    </div>\n                    <h1 class=\"mt-4 text-[30px] font-medium tracking-[-0.05em]\" data-kid=\"1-1-2-1-1-2\">\n                        Review your next agreement.\n                    </h1>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"1-1-2-1-2\">\n                    <span class=\"mono hidden items-center gap-2 text-[9px] uppercase tracking-[0.14em] text-[var(--muted)] sm:flex\" data-kid=\"1-1-2-1-2-1\" data-name=\"connection status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--teal-soft)]\" data-kid=\"1-1-2-1-2-1-1\">\n                        </span>\n                        Service connected\n                    </span>\n                    <button class=\"mono border rule-strong px-3 py-2 text-[9px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-1-2-1-2-2\" data-name=\"account dropdown button\" type=\"button\">\n                        Account\n                    </button>\n                </div>\n            </header>\n            <section class=\"top-grid mt-8 grid grid-cols-[1.55fr_0.85fr] gap-8\" data-kid=\"1-1-2-2\">\n                <article class=\"border hairline bg-[var(--surface)] p-6\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"flex items-start justify-between\" data-kid=\"1-1-2-2-1-1\">\n                        <span class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"target page info title\">\n                            01 - Target page\n                        </span>\n                        <span class=\"mono flex items-center gap-2 text-[9px] uppercase tracking-[0.12em] text-[var(--teal-soft)]\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"target page captured label\">\n                            <i aria-hidden=\"true\" class=\"h-3.5 w-3.5\" data-kid=\"1-1-2-2-1-1-2-1\" data-lucide=\"check-circle-2\">\n                            </i>\n                            Captured\n                        </span>\n                    </div>\n                    <div class=\"mt-8 grid gap-7 sm:grid-cols-[1fr_auto]\" data-kid=\"1-1-2-2-1-2\">\n                        <div class=\"min-w-0\" data-kid=\"1-1-2-2-1-2-1\">\n                            <div class=\"mono mb-3 text-[9px] uppercase tracking-[0.14em] text-[var(--dim)]\" data-kid=\"1-1-2-2-1-2-1-1\" data-name=\"analyzing status label\">\n                                Analyzing\n                            </div>\n                            <h2 class=\"truncate text-lg font-medium tracking-[-0.02em]\" data-kid=\"1-1-2-2-1-2-1-2\" data-name=\"target page title\">\n                                Example Corp - Terms of Service\n                            </h2>\n                            <div class=\"mono mt-3 truncate text-[11px] text-[var(--teal-soft)]\" data-kid=\"1-1-2-2-1-2-1-3\">\n                                https://example.com/terms-and-conditions\n                            </div>\n                        </div>\n                        <div class=\"border-l hairline pl-6 text-right\" data-kid=\"1-1-2-2-1-2-2\">\n                            <div class=\"mono text-[9px] uppercase tracking-[0.14em] text-[var(--dim)]\" data-kid=\"1-1-2-2-1-2-2-1\" data-name=\"captured metadata label\">\n                                Captured\n                            </div>\n                            <div class=\"mono mt-2 text-[10px] text-[var(--muted)]\" data-kid=\"1-1-2-2-1-2-2-2\">\n                                TODAY · 09:42 UTC\n                            </div>\n                            <button class=\"inputless-link mono mt-5 inline-flex items-center gap-2 text-[9px] uppercase tracking-[0.12em] text-[var(--muted)]\" data-kid=\"1-1-2-2-1-2-2-3\" data-name=\"change page button\" type=\"button\">\n                                Change page\n                                <i aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"1-1-2-2-1-2-2-3-1\" data-lucide=\"external-link\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"border hairline bg-[var(--surface)] p-6\" data-kid=\"1-1-2-2-2\">\n                    <div class=\"flex items-start justify-between\" data-kid=\"1-1-2-2-2-1\">\n                        <span class=\"mono text-[10px] uppercase tracking-[0.18em] text-[var(--dim)]\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"credit wallet title\">\n                            02 - Credit wallet\n                        </span>\n                        <i aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--teal-soft)]\" data-kid=\"1-1-2-2-2-1-2\" data-lucide=\"credit-card\" data-name=\"wallet icon\">\n                        </i>\n                    </div>\n                    <div class=\"mt-8 flex items-end justify-between\" data-kid=\"1-1-2-2-2-2\">\n                        <div data-kid=\"1-1-2-2-2-2-1\">\n                            <div class=\"text-[36px] font-medium leading-none tracking-[-0.08em]\" data-kid=\"1-1-2-2-2-2-1-1\" data-name=\"credit count value\">\n                                1\n                            </div>\n                            <div class=\"mono mt-2 text-[9px] uppercase tracking-[0.15em] text-[var(--muted)]\" data-kid=\"1-1-2-2-2-2-1-2\" data-name=\"credit remaining label\">\n                                Credit remaining\n                            </div>\n                        </div>\n                        <span class=\"mono text-[10px] text-[var(