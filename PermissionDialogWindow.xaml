<Window x:Class="StrideBrowser.PermissionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Permission Request" Height="220" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Topmost="True">
    <Border Background="{DynamicResource AppBackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
            CornerRadius="8" Padding="24"
            Effect="{DynamicResource DropShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding HostTitle}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,12" />
            
            <TextBlock Grid.Row="1" Text="{Binding RequestMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" />
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Deny"
                        Margin="0,0,12,0" Padding="16,8" Cursor="Hand"
                        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextMainBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        Click="BtnDeny_Click" />
                <Button Content="Allow" IsDefault="True"
                        Padding="16,8" Cursor="Hand"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                        Click="BtnAllow_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
