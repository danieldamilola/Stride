<Window x:Class="StrideBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StrideBrowser.Controls"
        Title="Stride Browser"
        Width="1280" Height="800"
        MinWidth="600" MinHeight="400"
        WindowStyle="None"
        Background="{DynamicResource BaseBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <DataTemplate x:Key="TabItemTemplate">
            <Grid Height="36" Cursor="Hand" Background="Transparent"
                  MouseRightButtonUp="TabItem_RightClick" Tag="{Binding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <!-- Pin indicator — 4px ember dot -->
                <Ellipse Grid.Column="0" Width="4" Height="4"
                         Fill="{DynamicResource Accent}" Margin="8,0,0,0"
                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                <!-- Favicon — 16×16 -->
                <Image Grid.Column="1" Source="{Binding Favicon}"
                       Width="16" Height="16" Margin="8,0,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- Title — 13px -->
                <TextBlock Grid.Column="2" Text="{Binding Title}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13" FontFamily="{DynamicResource UIFont}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0,4,0"/>
                <!-- Close — appears on hover -->
                <Button Grid.Column="3" Click="CloseTab_Click" Tag="{Binding}"
                        Style="{DynamicResource TabCloseBtn}" ToolTip="Close tab"
                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=Grid},
                                     Path=IsMouseOver, Converter={StaticResource BoolToVis}}">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.2" Width="7" Height="7" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <DockPanel>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  TOOLBAR — Full width. One row. Everything essential.  -->
        <!--  Stride branding | nav buttons | address bar | win ctrl  -->
        <!--  44px height. Draggable background.                    -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Height="44"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid x:Name="ToolbarRow" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>    <!-- Nav buttons -->
                    <ColumnDefinition Width="*"/>       <!-- Address bar (fills) -->
                    <ColumnDefinition Width="Auto"/>    <!-- Zoom indicator -->
                    <ColumnDefinition Width="Auto"/>    <!-- Window controls -->
                </Grid.ColumnDefinitions>

                <!-- Navigation: ← → ↻ -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Click="GoBack_Click" Style="{DynamicResource IconBtn}"
                            Width="30" Height="30" ToolTip="Back (Alt+Left)">
                        <Path Data="{StaticResource IconBack}"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.6" Width="11" Height="11"
                              Stretch="Uniform" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button Click="GoForward_Click" Style="{DynamicResource IconBtn}"
                            Width="30" Height="30" ToolTip="Forward (Alt+Right)">
                        <Path Data="{StaticResource IconForward}"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.6" Width="11" Height="11"
                              Stretch="Uniform" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button Click="Refresh_Click" Style="{DynamicResource IconBtn}"
                            Width="30" Height="30" ToolTip="Refresh (F5)">
                        <Path Data="{StaticResource IconRefresh}"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.6" Width="11" Height="11"
                              Stretch="Uniform" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent"/>
                    </Button>
                </StackPanel>

                <!-- Address bar with security icon overlay -->
                <Grid Grid.Column="1" Margin="4,6,8,6">
                    <TextBox x:Name="AddressBar"
                             Style="{DynamicResource AddressBarStyle}"
                             Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="AddressBar_KeyDown"
                             GotFocus="AddressBar_GotFocus"
                             PreviewMouseLeftButtonDown="AddressBar_PreviewMouseDown"/>
                    <!-- Security icon — sits over the template globe, code-behind swaps it -->
                    <Path x:Name="SecurityIcon"
                          Data="{StaticResource IconGlobe}"
                          Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.2" Width="13" Height="13"
                          Stretch="Uniform" HorizontalAlignment="Left"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          IsHitTestVisible="False"/>
                </Grid>

                <!-- Zoom indicator -->
                <TextBlock x:Name="ZoomIndicator" Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="11" FontFamily="{DynamicResource UIFont}"
                           Margin="0,0,4,0" Visibility="Collapsed"
                           Cursor="Hand"
                           MouseLeftButtonDown="ZoomIndicator_Click"/>

                <!-- Window controls: — □ × -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button Click="Minimize_Click" Style="{DynamicResource TitleBtn}">
                        <Path Data="{StaticResource IconMinimize}"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1" Width="10" Height="1"
                              Stretch="Fill"/>
                    </Button>
                    <Button Click="Maximize_Click" Style="{DynamicResource TitleBtn}">
                        <Path Data="{StaticResource IconMaximize}"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1" Width="10" Height="10"
                              Stretch="Uniform" Fill="Transparent"/>
                    </Button>
                    <Button Click="Close_Click" Style="{DynamicResource CloseTitleBtn}">
                        <Path Data="{StaticResource IconClose}"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.2" Width="10" Height="10"
                              Stretch="Uniform" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  BODY — Sidebar + Content side by side below toolbar   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140" MaxWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── SIDEBAR — Tabs only. Clean. ─── -->
            <Border x:Name="Sidebar" Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- Bottom: action buttons -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,4,0,0">
                        <StackPanel Margin="6,8,6,8">
                            <Button Click="NewTab_Click" Style="{DynamicResource SidebarActionBtn}"
                                    ToolTip="New Tab (Ctrl+T)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}"
                                          Stroke="{DynamicResource TextMuted}"
                                          StrokeThickness="1.4" Width="12" Height="12"
                                          Stretch="Uniform" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock Text="New Tab" Foreground="{DynamicResource TextMuted}"
                                               FontSize="13" FontFamily="{DynamicResource UIFont}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="Settings_Click" Style="{DynamicResource SidebarActionBtn}"
                                    ToolTip="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettings}"
                                          Stroke="{DynamicResource TextMuted}"
                                          StrokeThickness="1.4" Width="12" Height="12"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" Foreground="{DynamicResource TextMuted}"
                                               FontSize="13" FontFamily="{DynamicResource UIFont}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OneTab_Click" Style="{DynamicResource SidebarActionBtn}"
                                    ToolTip="OneTab">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTabList}"
                                          Stroke="{DynamicResource TextMuted}"
                                          StrokeThickness="1.4" Width="12" Height="12"
                                          Stretch="Uniform" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock Text="OneTab" Foreground="{DynamicResource TextMuted}"
                                               FontSize="13" FontFamily="{DynamicResource UIFont}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Tab list — fills remaining space -->
                    <ListBox x:Name="TabList"
                             Style="{DynamicResource HorizontalTabListStyle}"
                             SelectionChanged="TabList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             Margin="0,8,0,0"
                             PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TabList_PreviewMouseMove"
                             Drop="TabList_Drop" AllowDrop="True"
                             ItemTemplate="{StaticResource TabItemTemplate}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AnimatedStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                </DockPanel>
            </Border>

            <!-- ─── SIDEBAR SPLITTER — Drag to resize ─── -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4"
                          Background="Transparent" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          Cursor="SizeWE"/>

            <!-- ─── CONTENT — Pure web content ─── -->
            <Border x:Name="ContentArea" Grid.Column="2"
                    Background="{DynamicResource BaseBrush}"
                    ClipToBounds="True"
                    Margin="0,0,0,0">
                <Grid>
                    <!-- Loading bar — 2px ember gradient sweep -->
                    <Border x:Name="LoadingBar" Height="2" VerticalAlignment="Top"
                            Visibility="Collapsed" Panel.ZIndex="10"
                            Background="{DynamicResource AccentWash}" ClipToBounds="True">
                        <Border x:Name="LoadingIndicator" Width="120"
                                HorizontalAlignment="Left" CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource LoadingBarFadeColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource LoadingBarGlowColor}" Offset="0.5"/>
                                    <GradientStop Color="{DynamicResource LoadingBarFadeColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <!-- WebView2 host -->
                    <Grid x:Name="WebViewHost" Background="{DynamicResource BaseBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
