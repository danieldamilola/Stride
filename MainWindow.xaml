<Window x:Class="StrideBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StrideBrowser.Controls"
        xmlns:conv="clr-namespace:StrideBrowser.Converters"
        xmlns:models="clr-namespace:StrideBrowser.Models"
        xmlns:ui="clr-namespace:StrideBrowser.Services.UI"
        Title="Stride"
        Icon="pack://application:,,,/icons/stride.ico"
        Width="1280" Height="800"
        MinWidth="{x:Static ui:ToolbarLayoutMetrics.MinWindowWidth}" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BaseBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

        <Window.Resources>
        <conv:TabOpacityConverter x:Key="TabOpacityConverter"/>
        <conv:AddressFieldMaxWidthConverter x:Key="AddressFieldMaxWidthConverter"/>
        <conv:ToolbarActionVisibilityConverter x:Key="ToolbarActionVisibilityConverter"/>
        <conv:TabWidthToVisibilityConverter x:Key="TabWidthToVisibilityConverter"/>
        <conv:TabCloseVisibilityConverter x:Key="TabCloseVisibilityConverter"/>
        <conv:TabCloseOpacityConverter x:Key="TabCloseOpacityConverter"/>
        <!-- Per-window adaptive tint defaults. The tint adapter overrides these
             in Toolbar.Resources on light site colors. They stay dark here so the
             neutral toolbar renders exactly as before when tint is off.
             The three suggestion keys are deliberately absent: they live in the
             theme dictionaries, because one hard coded popup surface cannot serve
             both themes. The field borrows the popup surface while suggestions are
             open, so a popup only value that ignores the theme also made the field
             unreadable. -->
        <SolidColorBrush x:Key="AddressFieldBackground" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="AddressFieldBorder" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="PinnedTabBackground" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="TabCloseHoverBackground" Color="#1AFFFFFF"/>
        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="10,7,12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SuggestionHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentWash}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"
                           StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                           Width="12" Height="12" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Data="{StaticResource IconGlobe}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Kind}" Value="{x:Static models:SuggestionKind.History}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource IconClock}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Kind}" Value="{x:Static models:SuggestionKind.Shortcut}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource IconGlobe}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Kind}" Value="{x:Static models:SuggestionKind.Search}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource IconSearch}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Image Source="{Binding Favicon}" Width="14" Height="14"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Suffix}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
            </Grid>
        </DataTemplate>
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!--  FAVICON PILL TAB â€” The Stride signature element       -->
        <!--  Active: amber pill with favicon + title               -->
        <!--  Inactive: favicon circle only, 70% opacity            -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <DataTemplate x:Key="TabItemTemplate">
            <Grid Height="28" Cursor="Hand" Background="Transparent" Tag="{Binding}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource TabWidthToVisibilityConverter}, ConverterParameter=48}" Value="Collapsed">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Width" Value="16"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Favicon slot -->
                    <ColumnDefinition Width="Auto"/>   <!-- Audio indicator -->
                    <ColumnDefinition Width="*"/>      <!-- Title -->
                    <ColumnDefinition Width="Auto"/>   <!-- Close Button (hover only) -->
                </Grid.ColumnDefinitions>

                <!-- Favicon — centered 16x16 icon slot -->
                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.Visibility>
                            <MultiBinding Converter="{StaticResource TabCloseVisibilityConverter}" ConverterParameter="NarrowInverse">
                                <Binding Path="IsPinned"/>
                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                            </MultiBinding>
                        </Grid.Visibility>
                    <!-- Default Stride icon — hidden when site favicon loads -->
                    <Image Source="{Binding DataContext.FallbackIconUri, RelativeSource={RelativeSource AncestorType=Window}}"
                           Width="14" Height="14"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" x:Name="DefaultIcon">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Url}" Value="{x:Static models:InternalUrls.Downloads}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Url}" Value="{x:Static models:InternalUrls.History}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Url}" Value="{x:Static models:InternalUrls.Settings}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                        <Image.Opacity>
                            <MultiBinding Converter="{StaticResource TabOpacityConverter}">
                                <Binding Path="IsActive"/>
                                <Binding Path="IsHibernated"/>
                                <Binding Path="IsSleeping"/>
                                <Binding Path="DataContext.Settings.TabSleepOpacity" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="DataContext.Settings.TabHibernationOpacity" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                <Binding Path="DataContext.Settings.TabSleepDimEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="DataContext.Settings.TabHibernationDimEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </Image.Opacity>
                    </Image>
                    <!-- Internal page icon: Downloads -->
                    <Path Data="{StaticResource IconDownload}"
                          Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.4" Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Url}" Value="{x:Static models:InternalUrls.Downloads}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!-- Internal page icon: History -->
                    <Path Data="{StaticResource IconClock}"
                          Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.4" Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Url}" Value="{x:Static models:InternalUrls.History}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!-- Internal page icon: Settings -->
                    <Path Data="{StaticResource IconSettings}"
                          Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.4" Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Url}" Value="{x:Static models:InternalUrls.Settings}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!-- Site Favicon -->
                    <Image Source="{Binding Favicon}"
                           Width="16" Height="16" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" x:Name="FaviconImage">
                        <Image.Opacity>
                            <MultiBinding Converter="{StaticResource TabOpacityConverter}">
                                <Binding Path="IsActive"/>
                                <Binding Path="IsHibernated"/>
                                <Binding Path="IsSleeping"/>
                                <Binding Path="DataContext.Settings.TabSleepOpacity" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="DataContext.Settings.TabHibernationOpacity" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                <Binding Path="DataContext.Settings.TabSleepDimEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="DataContext.Settings.TabHibernationDimEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </Image.Opacity>
                    </Image>
                    </Grid>
                    <Button Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close tab"
                            Style="{DynamicResource IconBtn}" Width="16" Height="16" Padding="0">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource TabCloseVisibilityConverter}" ConverterParameter="Narrow">
                                <Binding Path="IsPinned"/>
                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                            </MultiBinding>
                        </Button.Visibility>
                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMuted}"
                              StrokeThickness="1.2" Width="7" Height="7" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>

                <!-- Tab title: 6px pre-title padding, clean typography -->
                <Button Grid.Column="1" Click="TabAudio_Click" Tag="{Binding}"
                        Width="24" Height="24" Padding="4" Margin="4,0,0,0" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="ToolTip" Value="Mute tab"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAudioIndicator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource TabWidthToVisibilityConverter}, ConverterParameter=48}" Value="Collapsed">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="ToolTip" Value="Unmute tab"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.2"
                          Width="12" Height="12" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 2 6 L 5 6 L 9 2 L 9 14 L 5 10 L 2 10 Z M 12 4 C 15 6 15 10 12 12"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Data" Value="M 2 6 L 5 6 L 9 2 L 9 14 L 5 10 L 2 10 Z M 11 5 L 15 11 M 15 5 L 11 11"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding Title}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="12" FontFamily="{DynamicResource UIFont}"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           TextTrimming="None"
                           ClipToBounds="True"
                           Margin="6,0,4,0"
                           x:Name="TabTitle">
                    <!-- Long titles soften out instead of ending in dots -->
                    <TextBlock.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0.78"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.OpacityMask>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.65"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                                <!-- Title hides only when the card is genuinely too narrow -->
                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource TabWidthToVisibilityConverter}, ConverterParameter=48}" Value="Collapsed">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- Pinned tabs never show title -->
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Close button: Helium hover-only, 4px rounded-rectangle highlight -->
                <Button Grid.Column="3" Click="CloseTab_Click" Tag="{Binding}"
                        ToolTip="Close tab"
                        Width="24" Height="24" Margin="0"
                        VerticalAlignment="Center" Cursor="Hand">
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource TabCloseVisibilityConverter}">
                            <Binding Path="IsPinned"/>
                            <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                            <Binding Path="IsActive"/>
                        </MultiBinding>
                    </Button.Visibility>
                    <Button.Opacity>
                        <MultiBinding Converter="{StaticResource TabCloseOpacityConverter}">
                            <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                            <Binding Path="IsActive"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                        </MultiBinding>
                    </Button.Opacity>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="4" Padding="3,1">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabCloseHoverBackground}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.2" Width="7" Height="7" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="LayoutRoot">
        <!-- Main layout: toolbar on top, content fills rest -->
        <DockPanel>

            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <!--  TAB STRIP â€” 36px. Favicon pills + nav + controls.    -->
            <!--  This IS the toolbar. No separate address bar.        -->
            <!--  Stride signature: compact, warm, minimal.            -->
            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <Border x:Name="Toolbar" DockPanel.Dock="Top"
                    Height="38"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid x:Name="ToolbarRow" Margin="6,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>    <!-- Nav buttons -->
                        <ColumnDefinition Width="*"/>       <!-- DockPanel for Tabs + Address Bar -->
                        <ColumnDefinition Width="Auto"/>    <!-- Action buttons -->
                        <ColumnDefinition Width="Auto"/>    <!-- Window controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Navigation: ← → ↻ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,2,0">
                        <Button Command="{Binding GoBackCommand}" Style="{DynamicResource IconBtn}"
                                Visibility="{Binding Settings.ShowBackArrow, Converter={StaticResource BoolToVis}}"
                                Width="28" Height="28" Margin="0,0,3,0" ToolTip="Back (Alt+Left)">
                            <Path Data="{StaticResource IconBack}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Command="{Binding GoForwardCommand}" Style="{DynamicResource IconBtn}"
                                Visibility="{Binding Settings.ShowForwardArrow, Converter={StaticResource BoolToVis}}"
                                Width="28" Height="28" Margin="0,0,3,0" ToolTip="Forward (Alt+Right)">
                            <Path Data="{StaticResource IconForward}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="RefreshButton" Command="{Binding RefreshCommand}" Style="{DynamicResource IconBtn}"
                                Visibility="{Binding Settings.ShowRefreshButton, Converter={StaticResource BoolToVis}}"
                                Width="28" Height="28">
                            <Button.ToolTip>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Refresh (F5)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Text" Value="Stop loading (Esc)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.ToolTip>
                            <Path
                                  Width="12" Height="12"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconRefresh}"/>
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconClose}"/>
                                                <Setter Property="Fill" Value="{x:Null}"/>
                                                <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                                                <Setter Property="StrokeThickness" Value="1.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>

                    <DockPanel x:Name="ToolbarCenter" Grid.Column="1" LastChildFill="True" Height="38">
                        <!-- URL domain grouping -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="DockPanel.Dock" Value="Right"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.AddressBarOnLeft}" Value="True">
                                            <Setter Property="DockPanel.Dock" Value="Left"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <!-- Standard address field: 28 DIP tall, 6 DIP radius, 200 DIP wide.
                                 As the window narrows the field gives width back to the tab
                                 strip instead of squeezing it, down to a 100 DIP floor, which is
                                 what the window minimum is derived from. No outline in any
                                 state, focused or with suggestions open: the filled surface is
                                 the whole field. Shows the bare domain until focused, then the
                                 full URL. -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                        Cursor="Hand"
                                        ToolTip="Click to edit URL (Ctrl+L)">
                                <Border x:Name="StandardAddressBarBorder"
                                        Padding="8,0"
                                        Width="200"
                                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AddressFieldMaxWidthConverter}}"
                                        Height="28"
                                        Margin="0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AddressFieldBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AddressFieldBorder}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="CornerRadius" Value="6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=StandardSuggestionsPopup, Path=IsOpen}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuggestionPopupBackground}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuggestionPopupBorder}"/>
                                                    <Setter Property="CornerRadius" Value="6,6,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="StandardSecurityIcon"
                                              Grid.Column="0"
                                              Data="{StaticResource IconLock}"
                                              Stroke="{DynamicResource TextMuted}"
                                              StrokeThickness="1.2" Width="12" Height="12"
                                              Stretch="Uniform" VerticalAlignment="Center"
                                              Margin="0,0,7,0"/>
                                        <TextBox x:Name="StandardAddressBar"
                                                 Grid.Column="1"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 BorderThickness="0"
                                                 FontSize="12" FontFamily="{DynamicResource UIFont}"
                                                 VerticalContentAlignment="Center"
                                                 CaretBrush="{DynamicResource TextPrimary}"
                                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="StandardAddressBar_TextChanged"
                                                 PreviewMouseDown="StandardAddressBar_PreviewMouseDown"
                                                 KeyDown="StandardAddressBar_KeyDown"
                                                 GotKeyboardFocus="StandardAddressBar_GotKeyboardFocus"
                                                 LostFocus="StandardAddressBar_LostFocus">
                                            <!-- Own template so the empty-input hint
                                                 paints inside the field's own clip and
                                                 sits on the field's text origin. The 2 DIP
                                                 left on the hint is measured, not assumed:
                                                 the stock ScrollViewer content host keeps a
                                                 fixed 2 DIP inset on its left, so glyphs in
                                                 the box start 2 DIP in from the box edge.
                                                 Rendering the hint's own string inside the
                                                 box and shifting the hint by that gap moved
                                                 its first inked column onto the box's.
                                                 ClipToBounds keeps the rest of the hint
                                                 inside the field at narrow widths. The hint
                                                 keys on empty text only, so it stays while
                                                 the field is focused and empty and clears
                                                 as soon as anything is typed. -->
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid ClipToBounds="True">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Focusable="False"
                                                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                                                        <TextBlock x:Name="AddressHint"
                                                                   Margin="2,0,0,0"
                                                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                   IsHitTestVisible="False"
                                                                   Text="Search the web or type a URL"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontSize="{TemplateBinding FontSize}"
                                                                   FontFamily="{TemplateBinding FontFamily}">
                                                            <!-- Default hidden in a style, not as a
                                                                 local value, so the template trigger
                                                                 below can still show it. A local
                                                                 Visibility would outrank the trigger and
                                                                 the hint would never appear. -->
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter TargetName="AddressHint" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                    </Grid>
                                </Border>
                                 <Popup x:Name="StandardSuggestionsPopup"
                                        PlacementTarget="{Binding ElementName=StandardAddressBarBorder}"
                                        Placement="Bottom"
                                        IsOpen="{Binding StandardPopupOpen}"
                                        StaysOpen="False"
                                        AllowsTransparency="True"
                                        VerticalOffset="0">
                                    <Border x:Name="StandardSuggestionsPopupBorder"
                                            Background="{DynamicResource SuggestionPopupBackground}"
                                            BorderBrush="{DynamicResource SuggestionPopupBorder}"
                                            BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,6,6"
                                            Width="{Binding ElementName=StandardAddressBarBorder, Path=ActualWidth}"
                                            Padding="4,4,4,4">
                                        <ListBox x:Name="StandardSuggestionsList"
                                                 ItemsSource="{Binding Suggestions}"
                                                 SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 MaxHeight="280"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                 KeyboardNavigation.DirectionalNavigation="Cycle"
                                                 FocusVisualStyle="{x:Null}"
                                                 PreviewMouseLeftButtonUp="StandardSuggestionsList_MouseUp"
                                                 ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                                                 ItemTemplate="{StaticResource SuggestionItemTemplate}"/>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Horizontal tab strip â€” favicon pills -->
                        <ui:TabStripLayout>
                        <ListBox x:Name="TabList"
                                 Style="{DynamicResource FaviconTabListStyle}"
                                 SelectionChanged="TabList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.PanningMode="HorizontalOnly"
                                 ScrollViewer.CanContentScroll="False"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="0"
                                 UseLayoutRounding="True" SnapsToDevicePixels="True"
                                 VerticalAlignment="Center"
                                 PreviewMouseWheel="TabList_PreviewMouseWheel"
                                 ItemTemplate="{StaticResource TabItemTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ui:TabShrinkPanel
                                        ViewportWidth="{Binding AvailableTabWidth, RelativeSource={RelativeSource AncestorType=ui:TabStripLayout}}"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <!-- New Tab (+) sits at the back of the last tab -->
                        <Button x:Name="NewTabButton" Click="NewTab_Click" Style="{DynamicResource IconBtn}"
                                DockPanel.Dock="Left" VerticalAlignment="Center"
                                Width="28" Height="28" ToolTip="New Tab (Ctrl+T)" Margin="4,0,6,0">
                            <Path Data="{StaticResource IconPlus}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                        </ui:TabStripLayout>
                    </DockPanel>

                    <!-- Action buttons. As the window narrows the optional buttons fold into the
                         overflow button, then the overflow button goes, then the settings button,
                         and their commands stay on their shortcuts. The trailing margin sits on
                         the settings button, so the action cluster costs the row nothing once it
                         is gone. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- ──── Downloads Button ──── -->
                        <Grid Width="28" Height="28" Margin="0,0,3,0" Cursor="Hand" ToolTip="Downloads (Ctrl+J)">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="{Binding Settings.ShowDownloadsIcon, Converter={StaticResource BoolToVis}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolbarActionVisibilityConverter}, ConverterParameter=Optional}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Ellipse Width="24" Height="24" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" 
                                     Visibility="{Binding HasActiveDownloads, Converter={StaticResource BoolToVis}}" />
                            <Ellipse Width="24" Height="24" Stroke="#10B981" StrokeThickness="2" 
                                     StrokeDashArray="{Binding ActiveDownloadsProgress, Converter={StaticResource ProgressToDashArray}}"
                                     StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5" 
                                     Visibility="{Binding HasActiveDownloads, Converter={StaticResource BoolToVis}}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Button Click="Downloads_Click" Style="{DynamicResource IconBtn}" Width="28" Height="28" FocusVisualStyle="{x:Null}">
                                <Path Data="{StaticResource IconDownload}" 
                                      Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                      StrokeThickness="1.4" Width="12" Height="12" 
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,3,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="{Binding Settings.ShowReaderIcon, Converter={StaticResource BoolToVis}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolbarActionVisibilityConverter}, ConverterParameter=Optional}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Button x:Name="ReaderButton" Command="{Binding ToggleReaderCommand}" Style="{DynamicResource IconBtn}"
                                    Width="28" Height="28" ToolTip="Reader view (Ctrl+Shift+R)">
                                <TextBlock Text="Aa" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </Grid>
                        <!-- ──────────── Update Button ──────────── -->
                        <Grid Width="28" Height="28" Margin="0,0,3,0" Cursor="Hand">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="{Binding ShowUpdateIcon, Converter={StaticResource BoolToVis}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolbarActionVisibilityConverter}, ConverterParameter=Optional}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                              
                            <Grid.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Update available - click to download"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowUpdateProgress}" Value="True">
                                                        <Setter Property="Text" Value="{Binding UpdateProgress, StringFormat=Downloading {0:P0} - please wait}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowUpdateCheckmark}" Value="True">
                                                        <Setter Property="Text" Value="Ready to install - click to restart"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToolTip>
                            </Grid.ToolTip>

                            <Ellipse Width="24" Height="24" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" 
                                     Visibility="{Binding ShowUpdateProgress, Converter={StaticResource BoolToVis}}" />
                              
                            <!-- Circular spinning progress ring - fills with progress and rotates while downloading like Downloads -->
                            <Ellipse Width="24" Height="24" Stroke="#10B981" StrokeThickness="2" 
                                     StrokeDashArray="{Binding UpdateProgress, Converter={StaticResource ProgressToDashArray}}"
                                     StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5" 
                                     Visibility="{Binding ShowUpdateProgress, Converter={StaticResource BoolToVis}}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowUpdateProgress}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="UpdateSpin">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="-90" To="270" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="UpdateSpin"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <Button Command="{Binding HandleUpdateClickCommand}" Style="{DynamicResource IconBtn}" Width="28" Height="28" FocusVisualStyle="{x:Null}">
                                <Grid>
                                    <!-- Gear -->
                                    <Path Data="{StaticResource IconSettings}" 
                                          Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                          StrokeThickness="1.4" Width="10" Height="10" 
                                          Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                          Margin="0,-4,0,0"/>
                                    <!-- Tray -->
                                    <Path Data="M 4 15 L 4 20 L 20 20 L 20 15" 
                                          Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                          StrokeThickness="1.4" Width="12" Height="12" 
                                          Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,8,0,0"/>
                                </Grid>
                            </Button>
                              
                            <!-- Red Dot (Available) -->
                            <Ellipse Width="6" Height="6" Fill="#F85149" 
                                     HorizontalAlignment="Right" VerticalAlignment="Top" 
                                     Margin="0,4,4,0" IsHitTestVisible="False"
                                     Visibility="{Binding ShowUpdateRedDot, Converter={StaticResource BoolToVis}}"/>

                            <!-- Green Checkmark (Ready to Install) -->
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0" 
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ShowUpdateCheckmark, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SurfaceBrush}"/>
                                <Path Data="M 2 5 L 4 7 L 8 2" Stroke="#10B981" StrokeThickness="1.5" Stretch="Uniform" Width="6" Height="6"/>
                            </Grid>
                        </Grid>

                        <!-- Overflow button: the optional buttons fold in here, and the same
                             commands open from its menu. -->
                        <Grid Margin="0,0,3,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolbarActionVisibilityConverter}, ConverterParameter=Overflow}" Value="Visible">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Button x:Name="ToolbarOverflowButton" Click="ToolbarOverflow_Click" Style="{DynamicResource IconBtn}"
                                    Width="28" Height="28" Cursor="Hand" ToolTip="More toolbar actions" FocusVisualStyle="{x:Null}">
                                <Grid Width="12" Height="12">
                                    <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource TextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Button.ContextMenu>
                                    <!-- The menu is raised by the button, so it reads its data
                                         context from the button it is placed against. -->
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Downloads" InputGestureText="Ctrl+J" Click="Downloads_Click"/>
                                        <MenuItem Header="Reader view" InputGestureText="Ctrl+Shift+R" Command="{Binding ToggleReaderCommand}"/>
                                        <MenuItem Header="Check for updates" Command="{Binding HandleUpdateClickCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <!-- Settings button: the action control that keeps its place longest, and
                             the one that carries the trailing margin the cluster ends with. -->
                        <Grid Margin="0,0,6,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="{Binding Settings.ShowSettingsIcon, Converter={StaticResource BoolToVis}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolbarActionVisibilityConverter}, ConverterParameter=Settings}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Button Click="Settings_Click" Style="{DynamicResource IconBtn}"
                                    ToolTip="Settings (Ctrl+,)" Width="28" Height="28" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Path Data="{StaticResource IconSettings}" 
                                      Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                      StrokeThickness="1.4" Width="14" Height="14" 
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Window controls: — □ ✕ -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Stretch">
                        <Button Click="Minimize_Click" Style="{DynamicResource TitleBtn}"
                                Width="42" Height="38">
                            <Path Data="{StaticResource IconMinimize}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1" Width="10" Height="1"
                                  Stretch="Fill"/>
                        </Button>
                        <Button Click="Maximize_Click" Style="{DynamicResource TitleBtn}"
                                Width="42" Height="38">
                            <Path Data="{StaticResource IconMaximize}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1" Width="10" Height="10"
                                  Stretch="Uniform" Fill="Transparent"/>
                        </Button>
                        <Button Click="Close_Click" Style="{DynamicResource CloseTitleBtn}"
                                Width="42" Height="38">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.2" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <!--  CONTENT â€” Full width. No sidebar. Just web content.  -->
            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <Border x:Name="ContentArea"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BaseBrush}"/>
                        <Style.Triggers>
                            <!-- The frame surface behind the gap matches the toolbar. With the
                                 rounded frame off it stays the content base, exactly as before. -->
                            <DataTrigger Binding="{Binding Settings.RoundedWebContentFrameEnabled}" Value="True">
                                <Setter Property="Background" Value="{Binding Background, ElementName=Toolbar}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Loading bar â€” 1.5px amber glow sweep, transparent track -->
                    <Border x:Name="LoadingBar" Height="1.5" VerticalAlignment="Top"
                            Visibility="Collapsed" Panel.ZIndex="10"
                            Background="Transparent" ClipToBounds="True">
                        <Border x:Name="LoadingIndicator" Width="100"
                                HorizontalAlignment="Left" CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource LoadingBarFadeColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource LoadingBarGlowColor}" Offset="0.5"/>
                                    <GradientStop Color="{DynamicResource LoadingBarFadeColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <!-- WebView2 host. Reader mode reuses the tab's own WebView2 with IsScriptEnabled toggled, no second instance. -->
                    <Grid x:Name="WebViewHost">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource BaseBrush}"/>
                                <Style.Triggers>
                                    <!-- Revealed in the four corners the page host clips away,
                                         so it matches the frame surface, not the page base. -->
                                    <DataTrigger Binding="{Binding Settings.RoundedWebContentFrameEnabled}" Value="True">
                                        <Setter Property="Background" Value="{Binding Background, ElementName=Toolbar}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <!-- Rounded frame outline. It sits outside the clipped page host, never
                         takes input, and the controller fills its geometry in from the one
                         shared frame geometry when the frame is on. The paint is transparent:
                         the rounded corner comes from the region on the page host, and a
                         painted stroke on top of it reads as a second inner border. -->
                    <Border x:Name="ContentFrameOutline" IsHitTestVisible="False" Visibility="Collapsed"
                            BorderBrush="Transparent"/>
                    <!-- Reader fallback overlay. Shows sanitized article as plain text without waiting for WebView navigation, so the UI never hangs. -->
                    <Border x:Name="ReaderFallbackOverlay" Visibility="Collapsed" Background="{DynamicResource BaseBrush}" Panel.ZIndex="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                                <TextBlock x:Name="ReaderFallbackTitle" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock x:Name="ReaderFallbackByline" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <TextBlock x:Name="ReaderFallbackText" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ReaderFallbackError" Visibility="Collapsed" Foreground="#F85149" TextWrapping="Wrap" Margin="0,16,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Link Preview dim backdrop -->
        <Border x:Name="LinkPreviewDim" Visibility="Collapsed" Background="#B8000000" Panel.ZIndex="90"
                MouseLeftButtonDown="LinkPreviewDim_Click"/>

    </Grid>
</Window>




