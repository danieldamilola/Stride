<Window x:Class="StrideBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StrideBrowser.Controls"
        xmlns:conv="clr-namespace:StrideBrowser.Converters"
        Title="Stride"
        Icon="pack://application:,,,/icons/stride.ico"
        Width="1280" Height="800"
        MinWidth="600" MinHeight="400"
        WindowStyle="None"
        Background="{DynamicResource BaseBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

        <Window.Resources>
        <conv:TabOpacityConverter x:Key="TabOpacityConverter"/>
        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="10,7,12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Background="{DynamicResource Accent}" CornerRadius="2" Opacity="0"/>
                                <Path x:Name="SearchArrow" Grid.Column="1" Data="{StaticResource IconClock}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0EFFFFFF"/>
                                <Setter TargetName="SearchArrow" Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentWash}"/>
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                                <Setter TargetName="SearchArrow" Property="Stroke" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestionItemTemplate">
            <TextBlock Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="#C8C4BF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  FAVICON PILL TAB — The Stride signature element       -->
        <!--  Active: amber pill with favicon + title               -->
        <!--  Inactive: favicon circle only, 70% opacity            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TabItemTemplate">
            <Grid Height="28" Cursor="Hand" Background="Transparent"
                  MouseRightButtonUp="TabItem_RightClick" Tag="{Binding}"
                  ToolTip="{Binding Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>    <!-- Favicon + hover close overlay -->
                    <ColumnDefinition Width="Auto"/>  <!-- Title (active only) -->
                    <ColumnDefinition Width="Auto"/>  <!-- Close pill (active only) -->
                </Grid.ColumnDefinitions>
                <!-- Pin indicator removed in favor of pill background -->
                <!-- Favicon — 20×20 area with 16×16 icon -->
                <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                    <!-- Default Stride icon — hidden when site favicon loads, shares same dim as favicon -->
                    <Image Source="pack://application:,,,/icons/stride-browser-32x32.png"
                           Width="14" Height="14"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" x:Name="DefaultIcon">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                        <Image.Opacity>
                            <MultiBinding Converter="{StaticResource TabOpacityConverter}">
                                <Binding Path="IsActive"/>
                                <Binding Path="IsHibernated"/>
                                <Binding Path="IsSleeping"/>
                                <Binding Path="DataContext.Settings.TabSleepOpacity" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="DataContext.Settings.TabHibernationOpacity" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                <Binding Path="DataContext.Settings.TabSleepDimEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="DataContext.Settings.TabHibernationDimEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </Image.Opacity>
                    </Image>
                    <!-- Actual favicon -->
                    <Image Source="{Binding Favicon}"
                           Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" x:Name="FaviconImage">
                        <Image.Opacity>
                            <MultiBinding Converter="{StaticResource TabOpacityConverter}">
                                <Binding Path="IsActive"/>
                                <Binding Path="IsHibernated"/>
                                <Binding Path="IsSleeping"/>
                                <Binding Path="DataContext.Settings.TabSleepOpacity" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="DataContext.Settings.TabHibernationOpacity" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                <Binding Path="DataContext.Settings.TabSleepDimEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="DataContext.Settings.TabHibernationDimEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </Image.Opacity>
                    </Image>
                    <!-- INACTIVE close: overlay on favicon, hover tab to show, hidden when selected -->
                    <Button Click="CloseTab_Click" Tag="{Binding}"
                            ToolTip="Close tab"
                            Width="12" Height="12"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-2,-2,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="3" Padding="1">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Fade in when hovering the TAB (ListBoxItem), not just favicon -->
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.08">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.08"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <!-- Hide completely when tab is selected (active uses pill close) -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.2" Width="5" Height="5" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
                <!-- Title — visible only when tab is selected -->
                <TextBlock Grid.Column="1" Text="{Binding Title}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="12" FontFamily="{DynamicResource UIFont}"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160"
                           Margin="6,0,0,0"
                           x:Name="TabTitle">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0.5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.Settings.ShowTabNames, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- Pinned tabs never show title -->
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- ACTIVE close: end of pill, always visible when selected -->
                <Button Grid.Column="2" Click="CloseTab_Click" Tag="{Binding}"
                        ToolTip="Close tab"
                        Width="14" Height="14" Margin="6,0,2,0"
                        VerticalAlignment="Center" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="4" Padding="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- Pinned tabs never show close button -->
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1" Width="6" Height="6" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="LayoutRoot">
        <!-- Main layout: toolbar on top, content fills rest -->
        <DockPanel>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  TAB STRIP — 36px. Favicon pills + nav + controls.    -->
            <!--  This IS the toolbar. No separate address bar.        -->
            <!--  Stride signature: compact, warm, minimal.            -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border x:Name="Toolbar" DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid x:Name="ToolbarRow" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>    <!-- Nav buttons -->
                        <ColumnDefinition Width="*"/>       <!-- DockPanel for Tabs + Address Bar -->
                        <ColumnDefinition Width="Auto"/>    <!-- Action buttons -->
                        <ColumnDefinition Width="Auto"/>    <!-- Window controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Navigation: ← → ↻ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Command="{Binding GoBackCommand}" Style="{DynamicResource IconBtn}"
                                Visibility="{Binding Settings.ShowBackArrow, Converter={StaticResource BoolToVis}}"
                                Width="26" Height="26" ToolTip="Back (Alt+Left)">
                            <Path Data="{StaticResource IconBack}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Command="{Binding GoForwardCommand}" Style="{DynamicResource IconBtn}"
                                Visibility="{Binding Settings.ShowForwardArrow, Converter={StaticResource BoolToVis}}"
                                Width="26" Height="26" ToolTip="Forward (Alt+Right)">
                            <Path Data="{StaticResource IconForward}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{DynamicResource IconBtn}"
                                Visibility="{Binding Settings.ShowRefreshButton, Converter={StaticResource BoolToVis}}"
                                Width="26" Height="26" ToolTip="Refresh (F5)">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{DynamicResource TextSecondary}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <DockPanel Grid.Column="1" LastChildFill="True">
                        <!-- URL domain and New Tab (+) Grouping -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="DockPanel.Dock" Value="Right"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.AddressBarOnLeft}" Value="True">
                                            <Setter Property="DockPanel.Dock" Value="Left"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <!-- URL domain - bare text, no background. Minimal. -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="4,0,8,0"
                                        Cursor="Hand"
                                        ToolTip="Click to edit URL (Ctrl+L)">
                                <Path x:Name="SecurityIcon"
                                      Data="{StaticResource IconGlobe}"
                                      Stroke="{DynamicResource TextMuted}"
                                      StrokeThickness="1" Width="10" Height="10"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="0,0,5,0"
                                      Visibility="{Binding Settings.UseFloatingCommandBar, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock x:Name="UrlLabel"
                                           Text="New Tab"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11.5" FontFamily="{DynamicResource UIFont}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Width="80"
                                           MouseLeftButtonDown="UrlLabel_Click"
                                           Visibility="{Binding Settings.UseFloatingCommandBar, Converter={StaticResource BoolToVis}}"/>
                                <Border x:Name="StandardAddressBarBorder"
                                        Padding="6,4"
                                        Width="240"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Settings.UseFloatingCommandBar, Converter={StaticResource InverseBoolToVis}, FallbackValue=Collapsed}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0DFFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=StandardSuggestionsPopup, Path=IsOpen}" Value="True">
                                                    <Setter Property="Background" Value="#111111"/>
                                                    <Setter Property="BorderBrush" Value="#2A2A2E"/>
                                                    <Setter Property="CornerRadius" Value="8,8,0,0"/>
                                                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="StandardSecurityIcon"
                                              Grid.Column="0"
                                              Data="{StaticResource IconLock}"
                                              Stroke="{DynamicResource TextMuted}"
                                              StrokeThickness="1" Width="10" Height="10"
                                              Stretch="Uniform" VerticalAlignment="Center"
                                              Margin="4,0,6,0"/>
                                        <TextBox x:Name="StandardAddressBar"
                                                 Grid.Column="1"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 BorderThickness="0"
                                                 FontSize="12" FontFamily="{DynamicResource UIFont}"
                                                 VerticalContentAlignment="Center"
                                                 CaretBrush="{DynamicResource TextPrimary}"
                                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="StandardAddressBar_TextChanged"
                                                 KeyDown="StandardAddressBar_KeyDown"
                                                 GotKeyboardFocus="StandardAddressBar_GotKeyboardFocus"
                                                 LostFocus="StandardAddressBar_LostFocus"/>
                                    </Grid>
                                </Border>
                                <Popup x:Name="StandardSuggestionsPopup"
                                       PlacementTarget="{Binding ElementName=StandardAddressBarBorder}"
                                       Placement="Bottom"
                                       IsOpen="{Binding ShowSuggestions}"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       Visibility="{Binding Settings.UseFloatingCommandBar, Converter={StaticResource InverseBoolToVis}}"
                                       VerticalOffset="0">
                                    <Border Background="#111111"
                                            BorderBrush="#2A2A2E" 
                                            BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,8,8"
                                            Width="{Binding ElementName=StandardAddressBarBorder, Path=ActualWidth}"
                                            Padding="4,4,4,4">
                                        <ListBox x:Name="StandardSuggestionsList"
                                                 ItemsSource="{Binding Suggestions}"
                                                 SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 MaxHeight="280"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                 KeyboardNavigation.DirectionalNavigation="Cycle"
                                                 FocusVisualStyle="{x:Null}"
                                                 PreviewMouseLeftButtonUp="StandardSuggestionsList_MouseUp"
                                                 ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                                                 ItemTemplate="{StaticResource SuggestionItemTemplate}"/>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <!-- Action buttons: + New Tab -->
                            <Button Click="NewTab_Click" Style="{DynamicResource IconBtn}"
                                    Width="26" Height="26" ToolTip="New Tab (Ctrl+T)" Margin="0,0,4,0">
                                <Path Data="{StaticResource IconPlus}"
                                      Stroke="{DynamicResource TextSecondary}"
                                      StrokeThickness="1.4" Width="10" Height="10"
                                      Stretch="Uniform" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Horizontal tab strip — favicon pills -->
                        <ListBox x:Name="TabList"
                                 Style="{DynamicResource FaviconTabListStyle}"
                                 SelectionChanged="TabList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.PanningMode="HorizontalOnly"
                                 ScrollViewer.CanContentScroll="False"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="4,0,4,0"
                                 VerticalAlignment="Center"
                                 PreviewMouseWheel="TabList_PreviewMouseWheel"
                                 AllowDrop="True"
                                 ItemTemplate="{StaticResource TabItemTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </DockPanel>

                    <!-- Action buttons: Downloads, Settings -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <!-- ──── Downloads Button ──── -->
                        <Grid Width="26" Height="26" Margin="4,0" Cursor="Hand" ToolTip="Downloads (Ctrl+J)"
                              Visibility="{Binding Settings.ShowDownloadsIcon, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="24" Height="24" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" 
                                     Visibility="{Binding HasActiveDownloads, Converter={StaticResource BoolToVis}}" />
                            <Ellipse Width="24" Height="24" Stroke="#10B981" StrokeThickness="2" 
                                     StrokeDashArray="{Binding ActiveDownloadsProgress, Converter={StaticResource ProgressToDashArray}}"
                                     StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5" 
                                     Visibility="{Binding HasActiveDownloads, Converter={StaticResource BoolToVis}}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Button Click="Downloads_Click" Style="{DynamicResource IconBtn}" Width="26" Height="26" FocusVisualStyle="{x:Null}">
                                <Path Data="{StaticResource IconDownload}" 
                                      Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                      StrokeThickness="1.4" Width="12" Height="12" 
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                        <Grid Visibility="{Binding Settings.ShowSettingsIcon, Converter={StaticResource BoolToVis}}">
                            <Button Click="Settings_Click" Style="{DynamicResource IconBtn}"
                                    ToolTip="Settings" Width="26" Height="26" Margin="4,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Path Data="{StaticResource IconSettings}" 
                                      Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                      StrokeThickness="1.4" Width="14" Height="14" 
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Ellipse x:Name="UpdateBadge" Width="8" Height="8" Fill="#F85149" 
                                     HorizontalAlignment="Right" VerticalAlignment="Top" 
                                     Margin="0,4,4,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- Window controls: — □ × -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Stretch">
                        <Button Click="Minimize_Click" Style="{DynamicResource TitleBtn}"
                                Width="42" Height="40">
                            <Path Data="{StaticResource IconMinimize}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1" Width="10" Height="1"
                                  Stretch="Fill"/>
                        </Button>
                        <Button Click="Maximize_Click" Style="{DynamicResource TitleBtn}"
                                Width="42" Height="40">
                            <Path Data="{StaticResource IconMaximize}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1" Width="10" Height="10"
                                  Stretch="Uniform" Fill="Transparent"/>
                        </Button>
                        <Button Click="Close_Click" Style="{DynamicResource CloseTitleBtn}"
                                Width="42" Height="40">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.2" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  CONTENT — Full width. No sidebar. Just web content.  -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border x:Name="ContentArea"
                    Background="{DynamicResource BaseBrush}"
                    ClipToBounds="True">
                <Grid>
                    <!-- Loading bar — 1.5px amber glow sweep, transparent track -->
                    <Border x:Name="LoadingBar" Height="1.5" VerticalAlignment="Top"
                            Visibility="Collapsed" Panel.ZIndex="10"
                            Background="Transparent" ClipToBounds="True">
                        <Border x:Name="LoadingIndicator" Width="100"
                                HorizontalAlignment="Left" CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource LoadingBarFadeColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource LoadingBarGlowColor}" Offset="0.5"/>
                                    <GradientStop Color="{DynamicResource LoadingBarFadeColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <!-- Page snapshot removed, no longer needed for airspace hack -->
                    <!-- WebView2 host -->
                    <Grid x:Name="WebViewHost" Background="{DynamicResource BaseBrush}"/>
                    <!-- Reader fallback overlay. Shows sanitized article as plain text without waiting for WebView navigation, so the UI never hangs. -->
                    <Border x:Name="ReaderFallbackOverlay" Visibility="Collapsed" Background="{DynamicResource BaseBrush}" Panel.ZIndex="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                                <TextBlock x:Name="ReaderFallbackTitle" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock x:Name="ReaderFallbackByline" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <TextBlock x:Name="ReaderFallbackText" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ReaderFallbackError" Visibility="Collapsed" Foreground="#F85149" TextWrapping="Wrap" Margin="0,16,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>

        <Grid x:Name="CommandBarGrid" Visibility="Collapsed" Panel.ZIndex="100">
            <!-- Backdrop dim — 50% black to clearly show floating panel -->
            <Border Background="#80000000"
                    MouseLeftButtonDown="CommandBarBackdrop_Click"/>
            <!-- Centered command bar — clearly lighter than the dim backdrop -->
            <Border x:Name="CommandBarPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    Width="540"
                    Background="#2C2C32"
                    BorderBrush="#444449"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8"
                                      Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="AddressBar"
                             Grid.Row="0"
                             Style="{DynamicResource CommandBarInputStyle}"
                             Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="AddressBar_KeyDown"
                             GotFocus="AddressBar_GotFocus"
                             LostFocus="AddressBar_LostFocus"
                             PreviewMouseLeftButtonDown="AddressBar_PreviewMouseDown"
                             TextChanged="AddressBar_TextChanged"/>

                    <!-- Suggestions Dropdown -->
                    <!-- Hairline separator above suggestions -->
                    <Border Grid.Row="1"
                            Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVis}}"
                            BorderBrush="#2A2A2E" BorderThickness="0,1,0,0"
                            Margin="8,4,8,0"/>

                    <ListBox x:Name="SuggestionsList"
                             Grid.Row="1"
                             ItemsSource="{Binding Suggestions}"
                             SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}"
                             Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVis}}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4,4,4,4"
                             MaxHeight="280"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             KeyboardNavigation.DirectionalNavigation="Cycle"
                             FocusVisualStyle="{x:Null}"
                             PreviewMouseLeftButtonUp="SuggestionsList_MouseUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="10,7,12,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Accent indicator bar (only shown when selected) -->
                                                    <Border x:Name="AccentBar"
                                                            Grid.Column="0"
                                                            Background="{DynamicResource Accent}"
                                                            CornerRadius="2"
                                                            Opacity="0"/>
                                                    <!-- Icon area -->
                                                    <Path x:Name="SearchArrow"
                                                          Grid.Column="1"
                                                          Data="{StaticResource IconClock}"
                                                          Stroke="{DynamicResource TextMuted}"
                                                          StrokeThickness="1.3"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Width="10" Height="10"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"/>
                                                    <!-- Text -->
                                                    <ContentPresenter Grid.Column="2"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#0EFFFFFF"/>
                                                    <Setter TargetName="SearchArrow" Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentWash}"/>
                                                    <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="SearchArrow" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="13"
                                           Foreground="#C8C4BF"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



