<Window x:Class="StrideBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StrideBrowser.Controls"
        Title="Stride"
        Icon="icons/stride.ico"
        Width="1280" Height="800"
        MinWidth="600" MinHeight="400"
        WindowStyle="None"
        Background="{DynamicResource BaseBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  FAVICON PILL TAB — The Stride signature element       -->
        <!--  Active: amber pill with favicon + title               -->
        <!--  Inactive: favicon circle only, 70% opacity            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TabItemTemplate">
            <Grid Height="28" Cursor="Hand" Background="Transparent"
                  MouseRightButtonUp="TabItem_RightClick" Tag="{Binding}"
                  ToolTip="{Binding Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Pin dot -->
                    <ColumnDefinition Width="20"/>    <!-- Favicon + hover close overlay -->
                    <ColumnDefinition Width="Auto"/>  <!-- Title (active only) -->
                    <ColumnDefinition Width="Auto"/>  <!-- Close pill (active only) -->
                </Grid.ColumnDefinitions>
                <!-- Pin indicator — 3px amber dot -->
                <Ellipse Grid.Column="0" Width="3" Height="3"
                         Fill="{DynamicResource Accent}" Margin="0,0,2,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                <!-- Favicon — 20×20 area with 16×16 icon -->
                <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                    <!-- Default Stride icon — greyed out, hidden when site favicon loads -->
                    <Image Source="icons/stride-browser-32x32.png"
                           Width="14" Height="14" Opacity="0.3"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" x:Name="DefaultIcon">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <!-- Actual favicon -->
                    <Image Source="{Binding Favicon}"
                           Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" x:Name="FaviconImage"/>
                    <!-- INACTIVE close: overlay on favicon, hover tab to show, hidden when selected -->
                    <Button Click="CloseTab_Click" Tag="{Binding}"
                            ToolTip="Close tab"
                            Width="12" Height="12"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-2,-2,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="3" Padding="1">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Fade in when hovering the TAB (ListBoxItem), not just favicon -->
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.08">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.08"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <!-- Hide completely when tab is selected (active uses pill close) -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.2" Width="5" Height="5" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
                <!-- Title — visible only when tab is selected -->
                <TextBlock Grid.Column="2" Text="{Binding Title}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="12" FontFamily="{DynamicResource UIFont}"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160"
                           Margin="6,0,0,0"
                           x:Name="TabTitle">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- ACTIVE close: end of pill, always visible when selected -->
                <Button Grid.Column="3" Click="CloseTab_Click" Tag="{Binding}"
                        ToolTip="Close tab"
                        Width="14" Height="14" Margin="6,0,2,0"
                        VerticalAlignment="Center" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="4" Padding="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1" Width="6" Height="6" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Main layout: toolbar on top, content fills rest -->
        <DockPanel>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  TAB STRIP — 36px. Favicon pills + nav + controls.    -->
            <!--  This IS the toolbar. No separate address bar.        -->
            <!--  Stride signature: compact, warm, minimal.            -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border x:Name="Toolbar" DockPanel.Dock="Top" Height="36"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid x:Name="ToolbarRow" Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>    <!-- Nav buttons -->
                        <ColumnDefinition Width="*"/>       <!-- Tab strip (fills) -->
                        <ColumnDefinition Width="Auto"/>    <!-- URL label -->
                        <ColumnDefinition Width="Auto"/>    <!-- Action buttons -->
                        <ColumnDefinition Width="Auto"/>    <!-- Window controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Navigation: ← → ↻ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Click="GoBack_Click" Style="{DynamicResource IconBtn}"
                                Width="26" Height="26" ToolTip="Back (Alt+Left)">
                            <Path Data="{StaticResource IconBack}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Click="GoForward_Click" Style="{DynamicResource IconBtn}"
                                Width="26" Height="26" ToolTip="Forward (Alt+Right)">
                            <Path Data="{StaticResource IconForward}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Click="Refresh_Click" Style="{DynamicResource IconBtn}"
                                Width="26" Height="26" ToolTip="Refresh (F5)">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{DynamicResource TextSecondary}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Horizontal tab strip — favicon pills -->
                    <ListBox x:Name="TabList" Grid.Column="1"
                             Style="{DynamicResource FaviconTabListStyle}"
                             SelectionChanged="TabList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Background="Transparent" BorderThickness="0"
                             Margin="4,0,4,0"
                             VerticalAlignment="Center"
                             PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TabList_PreviewMouseMove"
                             Drop="TabList_Drop" AllowDrop="True"
                             ItemTemplate="{StaticResource TabItemTemplate}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- URL domain — bare text, no background. Minimal. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="4,0,8,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="UrlLabel_Click"
                                ToolTip="Click to edit URL (Ctrl+L)">
                        <Path x:Name="SecurityIcon"
                              Data="{StaticResource IconGlobe}"
                              Stroke="{DynamicResource TextMuted}"
                              StrokeThickness="1" Width="10" Height="10"
                              Stretch="Uniform" VerticalAlignment="Center"
                              Margin="0,0,5,0"/>
                        <TextBlock x:Name="UrlLabel"
                                   Text="New Tab"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="11.5" FontFamily="{DynamicResource UIFont}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200"/>
                    </StackPanel>

                    <!-- Action buttons: + New Tab, Search -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Click="NewTab_Click" Style="{DynamicResource IconBtn}"
                                Width="26" Height="26" ToolTip="New Tab (Ctrl+T)">
                            <Path Data="{StaticResource IconPlus}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                        <Grid>
                            <Button Click="Downloads_Click" Style="{DynamicResource IconBtn}"
                                    ToolTip="Downloads (Ctrl+J)" Width="26" Height="26" Margin="4,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Path Data="{StaticResource IconDownload}" 
                                      Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                      StrokeThickness="1.4" Width="12" Height="12" 
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                            <Ellipse x:Name="DownloadActiveDot" Width="6" Height="6" 
                                     Fill="#10B981" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                     Margin="0,4,4,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid>
                            <Button Click="Settings_Click" Style="{DynamicResource IconBtn}"
                                    ToolTip="Settings" Width="26" Height="26" Margin="4,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Path Data="{StaticResource IconSettings}" 
                                      Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                      StrokeThickness="1.4" Width="14" Height="14" 
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Ellipse x:Name="UpdateBadge" Width="8" Height="8" Fill="#F85149" 
                                     HorizontalAlignment="Right" VerticalAlignment="Top" 
                                     Margin="0,4,4,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- Window controls: — □ × -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                VerticalAlignment="Stretch">
                        <Button Click="Minimize_Click" Style="{DynamicResource TitleBtn}"
                                Width="42" Height="36">
                            <Path Data="{StaticResource IconMinimize}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1" Width="10" Height="1"
                                  Stretch="Fill"/>
                        </Button>
                        <Button Click="Maximize_Click" Style="{DynamicResource TitleBtn}"
                                Width="42" Height="36">
                            <Path Data="{StaticResource IconMaximize}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1" Width="10" Height="10"
                                  Stretch="Uniform" Fill="Transparent"/>
                        </Button>
                        <Button Click="Close_Click" Style="{DynamicResource CloseTitleBtn}"
                                Width="42" Height="36">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.2" Width="10" Height="10"
                                  Stretch="Uniform" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  CONTENT — Full width. No sidebar. Just web content.  -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border x:Name="ContentArea"
                    Background="{DynamicResource BaseBrush}"
                    ClipToBounds="True">
                <Grid>
                    <!-- Loading bar — 1.5px amber glow sweep, transparent track -->
                    <Border x:Name="LoadingBar" Height="1.5" VerticalAlignment="Top"
                            Visibility="Collapsed" Panel.ZIndex="10"
                            Background="Transparent" ClipToBounds="True">
                        <Border x:Name="LoadingIndicator" Width="100"
                                HorizontalAlignment="Left" CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource LoadingBarFadeColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource LoadingBarGlowColor}" Offset="0.5"/>
                                    <GradientStop Color="{DynamicResource LoadingBarFadeColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <!-- Page snapshot — shown dimmed when command bar is open -->
                    <Image x:Name="PageSnapshot" Stretch="Fill"
                           Visibility="Collapsed" Opacity="0.3"/>
                    <!-- WebView2 host -->
                    <Grid x:Name="WebViewHost" Background="{DynamicResource BaseBrush}"/>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  COMMAND BAR — Floating overlay. Centered. On-demand.  -->
        <!--  Appears on Ctrl+L / click URL label. Disappears on   -->
        <!--  Escape or click-away. No permanent address bar.      -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="CommandBarOverlay" Visibility="Collapsed" Panel.ZIndex="100">
            <!-- Backdrop dim — 50% black to clearly show floating panel -->
            <Border Background="#80000000"
                    MouseLeftButtonDown="CommandBarBackdrop_Click"/>
            <!-- Centered command bar — clearly lighter than the dim backdrop -->
            <Border x:Name="CommandBarPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    Width="540"
                    Background="#2C2C32"
                    BorderBrush="#444449"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8"
                                      Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="AddressBar"
                             Style="{DynamicResource CommandBarInputStyle}"
                             Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="AddressBar_KeyDown"
                             GotFocus="AddressBar_GotFocus"
                             LostFocus="AddressBar_LostFocus"
                             PreviewMouseLeftButtonDown="AddressBar_PreviewMouseDown"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
