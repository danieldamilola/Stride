<Window x:Class="StrideBrowser.BaseBrowserDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="Auto" SizeToContent="Height" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="{DynamicResource BaseBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
            CornerRadius="14" Padding="28" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding DialogTitle}" FontWeight="SemiBold" FontSize="14" 
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="80">
                <TextBlock Text="{Binding DialogMessage}" TextWrapping="Wrap" 
                           Foreground="{DynamicResource TextSecondary}" FontSize="12.5" 
                           LineHeight="20" />
            </ScrollViewer>
            
            <TextBox x:Name="InputBox" Grid.Row="2" Visibility="{Binding InputVisibility}" 
                     Margin="0,14,0,0" Padding="10,8" FontSize="12.5"
                     Background="{DynamicResource SurfaceBrush}" 
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{Binding CancelButtonText}" x:Name="BtnCancel" 
                        Visibility="{Binding CancelVisibility}"
                        Margin="0,0,8,0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource TextSecondaryColor}"/>
                    </Button.Foreground>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding OkButtonText}" x:Name="BtnOk" IsDefault="True"
                        Cursor="Hand" Click="BtnOk_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource TextPrimaryColor}"/>
                    </Button.Foreground>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
