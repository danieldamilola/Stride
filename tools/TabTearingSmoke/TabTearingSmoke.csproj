<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UmberTabTearingSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Umber.csproj" />
    <Page Include="../../Themes/*.xaml" Link="Themes/%(Filename)%(Extension)" />
    <Resource Include="../../icons/*.ico;../../icons/umber-browser-*.png" Link="icons/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../App.xaml" LogicalName="BrowserResources.xaml" />
  </ItemGroup>
</Project>