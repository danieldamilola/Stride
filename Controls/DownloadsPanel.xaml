<UserControl x:Class="UmberBrowser.Controls.DownloadsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UmberBrowser.Models"
             KeyboardNavigation.TabNavigation="Cycle" Focusable="True"
             AutomationProperties.Name="Recent downloads">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="DownloadBoolToVisibility"/>
        <Style x:Key="DownloadAction" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DownloadGlyph" TargetType="Path">
            <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <Grid Margin="16,10,10,6">
                <TextBlock Text="Recent downloads" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Style="{StaticResource DownloadAction}"
                        ToolTip="Close downloads" AutomationProperties.Name="Close downloads">
                    <Path Style="{StaticResource DownloadGlyph}" Data="M3,3 L13,13 M13,3 L3,13" Width="12" Height="12"/>
                </Button>
            </Grid>
            <TextBlock Text="No recent downloads." Foreground="{DynamicResource TextSecondary}" Margin="16,12,16,20">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                    <DataTrigger Binding="{Binding RecentDownloads.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ScrollViewer x:Name="DownloadsScroll" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RecentDownloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DownloadItem}">
                            <Grid Margin="16,6,10,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.RowSpan="2" Width="20" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,8,0">
                                    <Image Source="{Binding FileIcon}" Stretch="Uniform"/>
                                    <Path Data="M3,1 L10,1 L15,6 L15,19 L3,19 Z M10,1 L10,6 L15,6" Width="17" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FileIcon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"
                                           Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding PopupDetailText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PopupDetailText}"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,3,6,0" AutomationProperties.LiveSetting="Polite"/>
                                <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource DownloadAction}" ToolTip="Pause" AutomationProperties.Name="Pause download" Visibility="{Binding CanPause, Converter={StaticResource DownloadBoolToVisibility}}" Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Style="{StaticResource DownloadGlyph}" Data="M4,2 L4,14 M11,2 L11,14"/>
                                    </Button>
                                    <Button Style="{StaticResource DownloadAction}" ToolTip="Resume" AutomationProperties.Name="Resume download" Visibility="{Binding CanResume, Converter={StaticResource DownloadBoolToVisibility}}" Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Style="{StaticResource DownloadGlyph}" Data="M4,2 L13,8 L4,14 Z"/>
                                    </Button>
                                    <Button Style="{StaticResource DownloadAction}" ToolTip="{Binding RetryLabel}" AutomationProperties.Name="{Binding RetryLabel}" Visibility="{Binding CanRestart, Converter={StaticResource DownloadBoolToVisibility}}" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Style="{StaticResource DownloadGlyph}" Data="M13,6 A6,6 0 1 0 13,11 M13,2 L13,6 L9,6"/>
                                    </Button>
                                    <Button Style="{StaticResource DownloadAction}" ToolTip="Cancel" AutomationProperties.Name="Cancel download" Visibility="{Binding CanCancel, Converter={StaticResource DownloadBoolToVisibility}}" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Style="{StaticResource DownloadGlyph}" Data="M8,1 A7,7 0 1 1 7.99,1 M5,5 L11,11 M11,5 L5,11"/>
                                    </Button>
                                    <Button Style="{StaticResource DownloadAction}" ToolTip="Open file" AutomationProperties.Name="Open file" Visibility="{Binding CanOpen, Converter={StaticResource DownloadBoolToVisibility}}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Style="{StaticResource DownloadGlyph}" Data="M9,2 L14,2 L14,7 M14,2 L7,9 M6,3 L2,3 L2,14 L13,14 L13,10"/>
                                    </Button>
                                    <Button Style="{StaticResource DownloadAction}" ToolTip="Show in folder" AutomationProperties.Name="Show in folder" Visibility="{Binding CanOpen, Converter={StaticResource DownloadBoolToVisibility}}" Command="{Binding DataContext.FolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Style="{StaticResource DownloadGlyph}" Data="M1,13 L1,3 L6,3 L8,5 L15,5 L15,13 Z M1,7 L15,7"/>
                                    </Button>
                                </StackPanel>
                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Height="3" Margin="0,9,6,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate}" Foreground="{DynamicResource ProgressBrush}" Background="{DynamicResource BorderBrush}"
                                             AutomationProperties.Name="Download progress">
                                    <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadState.Completed}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadState.Failed}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadState.Cancelled}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsStarting}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers></Style></ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,6,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0">
                <Button x:Name="ViewAllButton" Style="{StaticResource DownloadAction}" Width="Auto" Height="40" Padding="16,0" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource TextPrimary}" ToolTip="Full download history" AutomationProperties.Name="Full download history">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Full download history" FontSize="12" VerticalAlignment="Center"/>
                        <Path Grid.Column="1" Style="{StaticResource DownloadGlyph}" Data="M9,2 L14,2 L14,7 M14,2 L7,9 M6,3 L2,3 L2,14 L13,14 L13,10" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
