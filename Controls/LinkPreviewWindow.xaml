<Window x:Class="StrideBrowser.Controls.LinkPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Preview"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BaseBrush}"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        WindowStartupLocation="CenterOwner"
        MinWidth="360" MinHeight="240"
        Width="640" Height="480">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="#2A2A2E"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource BaseBrush}" CornerRadius="12,12,0,0"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="UrlText" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Text="Preview"/>
                        <TextBlock x:Name="TitleText" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Text="Loading..."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="OpenNewTabButton" Style="{DynamicResource IconBtn}" Width="32" Height="32" ToolTip="Open in new tab" Margin="4,0" Click="OpenNewTab_Click">
                            <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="OpenCurrentButton" Style="{DynamicResource IconBtn}" Width="32" Height="32" ToolTip="Open in current tab" Margin="0,0,4,0" Click="OpenCurrent_Click">
                            <Path Data="{StaticResource IconForward}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{DynamicResource IconBtn}" Width="32" Height="32" ToolTip="Close (Esc)" Click="Close_Click">
                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource BaseBrush}" CornerRadius="0,0,12,12" ClipToBounds="True">
                <Grid x:Name="PreviewHost"/>
            </Border>
        </Grid>
    </Border>
</Window>
